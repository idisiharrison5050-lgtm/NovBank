<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | NovBank</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/dashboard-shell.css"/>
  <link rel="stylesheet" href="/css/mobile-dashboard.css?v=nav4"/>
  <%- typeof extraCSS !== 'undefined' ? extraCSS : '' %>
  <style>
  @media (max-width: 768px) {
    .sidebar { display: flex; transform: translateX(-100%); }
  }
</style>
<style>
  .receipt-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 999;
    align-items: center;
    justify-content: center;
  }

  .receipt-modal-overlay.open {
    display: flex;
  }

  .receipt-modal {
    background: #fff;
    border-radius: 16px;
    padding: 32px;
    width: 100%;
    max-width: 440px;
    max-height: 90vh;
    overflow-y: auto;
    margin: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
  }

  .receipt-header {
    text-align: center;
    margin-bottom: 24px;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 16px;
  }

  .receipt-bank-name {
    font-size: 1.1rem;
    font-weight: 801;
    color: #1a56db;
    margin-bottom: 4px;
  }

  .receipt-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #94a3b8;
    margin: 0;
  }

  .receipt-amount {
    text-align: center;
    margin: 20px 0;
  }

  .receipt-amount-value {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
  }

  .receipt-amount-label {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 2px;
  }

  .receipt-status-badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: capitalize;
    margin-top: 8px;
  }

  .receipt-status-completed { background: #dcfce7; color: #16a34a; }
  .receipt-status-pending   { background: #fef3c7; color: #d97706; }
  .receipt-status-failed    { background: #fee2e2; color: #ef4444; }

  .receipt-rows {
    border-top: 1px dashed #e2e8f0;
    border-bottom: 1px dashed #e2e8f0;
    padding: 16px 0;
    margin-bottom: 20px;
  }

  .receipt-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 7px 0;
    font-size: 0.86rem;
  }

  .receipt-row-label {
    color: #94a3b8;
    font-weight: 500;
    flex-shrink: 0;
    margin-right: 12px;
  }

  .receipt-row-value {
    color: #0f172a;
    font-weight: 600;
    text-align: right;
    word-break: break-all;
  }

  .receipt-actions {
    display: flex;
    gap: 10px;
  }

  .receipt-actions .btn {
    flex: 1;
    font-size: 0.88rem;
    padding: 10px;
    border-radius: 8px;
    font-weight: 600;
  }

  .receipt-divider {
    border: none;
    border-top: 1px dashed #e2e8f0;
    margin: 4px 0;
  }

  @media (max-width: 480px) {
    .receipt-modal { padding: 24px 18px; }
    .receipt-amount-value { font-size: 1.6rem; }
  }
</style>
<style>
.nb-impersonation-banner{position:fixed;top:0;left:0;right:0;z-index:2000;min-height:38px;padding:9px 14px;background:#fff4cc;border-bottom:1px solid #e5c85b;color:#4b3b00;display:flex;align-items:center;justify-content:center;gap:10px;font-size:11px}
.nb-impersonation-banner strong{font-size:10px;letter-spacing:.08em}.nb-impersonation-banner span{color:#6b5a20}.nb-impersonation-banner a{padding:6px 10px;border-radius:7px;background:#101828;color:#fff;text-decoration:none;font-weight:800;font-size:10px}
@media(max-width:600px){.nb-impersonation-banner{justify-content:flex-start;flex-wrap:wrap;padding:8px 10px}.nb-impersonation-banner span{display:none}}
</style></head>
<div class="nb-navigation-loader" id="nbNavigationLoader" aria-label="Loading NovBank" role="status">
  <div class="nb-loader-scene" aria-hidden="true">
    <div class="nb-loader-orbit nb-orbit-one"><span></span></div>
    <div class="nb-loader-orbit nb-orbit-two"><span></span></div>
    <div class="nb-loader-orbit nb-orbit-three"><span></span></div>
    <div class="nb-loader-core"><i></i></div>
  </div>
  <div class="nb-loader-copy">
    <strong>NovBank</strong>
    <small>Preparing your secure banking experience</small>
  </div>
</div>
<% if (typeof session !== 'undefined' && session.impersonating) { %>
<div class="nb-impersonation-banner">
  <strong>SUPER ADMIN MODE</strong>
  <span>You are viewing a user account.</span>
  <a href="/admin-session/exit">Return to Admin</a>
</div>
<% } %>
<body>
