<!-- Google Translate: compact language selector shared across NovBank pages -->
<style>
  .nb-translate-bar{width:100%;display:flex;align-items:center;justify-content:flex-end;gap:6px;padding:2px 12px;background:#f7f9fc;border-bottom:1px solid #e5eaf1;color:#26364b;font:500 13px/1.4 Arial,sans-serif;box-sizing:border-box}
  .nb-translate-bar #google_translate_element{min-height:18px;line-height:1}
  .nb-translate-bar .goog-te-gadget{font:12px Arial,sans-serif;color:#26364b}
  .nb-translate-bar .goog-te-gadget .goog-te-combo{margin:0;padding:2px 6px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;color:#1e293b;max-width:190px}
  .goog-te-banner-frame.skiptranslate{display:none!important}
  body{top:0!important}
  @media(max-width:480px){.nb-translate-bar{padding:1px 10px;justify-content:flex-end}.nb-translate-bar .goog-te-gadget .goog-te-combo{max-width:150px}}
</style>
<div class="nb-translate-bar" role="region" aria-label="Website language">
  <div id="google_translate_element"></div>
</div>
<script>
  function googleTranslateElementInit() {
    if (window.google && window.google.translate && !window.nbGoogleTranslateInitialized) {
      window.nbGoogleTranslateInitialized = true;
      new google.translate.TranslateElement({
        pageLanguage: 'en',
        includedLanguages: 'ar,bn,zh-CN,fr,de,ha,hi,ig,ja,pt,ru,es,sw,yo,zu',
        autoDisplay: false
      }, 'google_translate_element');
    }
  }
</script>
<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>
