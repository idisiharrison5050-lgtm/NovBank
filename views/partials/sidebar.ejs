    <a href="/transfer" class="sidebar-link <%= title === 'Send Money' ? 'active' : '' %>"><span class="nb-nav-icon">↗</span><span>Send money</span></a>
    <a href="/transfer/deposit" class="sidebar-link <%= title === 'Deposit Funds' ? 'active' : '' %>"><span class="nb-nav-icon">↓</span><span>Add money</span></a>
    <a href="/transfer/wire" class="sidebar-link <%= title === 'Wire Transfer' ? 'active' : '' %>"><span class="nb-nav-icon">⇄</span><span>Wire transfer</span></a>
    <a href="/cards" class="sidebar-link <%= title === 'Cards' ? 'active' : '' %>"><span class="nb-nav-icon">▣</span><span>Cards</span></a>
