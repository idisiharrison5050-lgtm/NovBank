<aside class="sidebar nb-sidebar">
  <div class="sidebar-logo nb-sidebar-brand">
    <img src="/images/nav.png" alt="NovBank" width="30" height="30">
    <span>NovBank</span>
  </div>
  <div class="nb-sidebar-section">BANKING</div>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= title === 'Dashboard' ? 'active' : '' %>"><span class="nb-nav-icon">⌂</span><span>Overview</span></a>
