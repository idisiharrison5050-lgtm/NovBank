<aside class="sidebar nb-sidebar">
  <div class="sidebar-logo nb-sidebar-brand">
    <img src="/images/nav.png" alt="NovBank" width="30" height="30">
    <span>NovBank</span>
  </div>

  <div class="nb-sidebar-section">MAIN</div>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= title === 'Dashboard' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3l8.5 7.5"></path><path d="M5.5 9.5V21h13V9.5"></path><path d="M9.5 21v-6h5v6"></path></svg></span><span>Dashboard</span>
    </a>
    <a href="/dashboard/transactions" class="sidebar-link <%= title === 'Transactions' || title === 'Transaction' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12"></path><path d="M6 12h12"></path><path d="M6 17h8"></path><circle cx="4" cy="7" r="1"></circle><circle cx="4" cy="12" r="1"></circle><circle cx="4" cy="17" r="1"></circle></svg></span><span>Transactions</span>
    </a>
    <a href="/cards" class="sidebar-link <%= title === 'Cards' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="M3 10h18"></path><path d="M7 15h3"></path></svg></span><span>Cards</span>
    </a>

    <div class="nb-sidebar-section nb-sidebar-section-spaced">MONEY</div>
    <a href="/transfer" class="sidebar-link <%= title === 'Send Money' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15"></path><path d="m13 6 6 6-6 6"></path></svg></span><span>Send money</span>
    </a>
    <a href="/receive" class="sidebar-link <%= title === 'Receive Money' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15"></path><path d="m6 13 6 6 6-6"></path></svg></span><span>Receive money</span>
    </a>
    <a href="/transfer/wire" class="sidebar-link <%= title === 'Wire Transfer' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14"></path><path d="m15 4 4 3-4 3"></path><path d="M19 17H5"></path><path d="m9 14-4 3 4 3"></path></svg></span><span>International wire</span>
    </a>
    <a href="/transfer/deposit" class="sidebar-link <%= title === 'Deposit Funds' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v13"></path><path d="m7 12 5 5 5-5"></path><path d="M5 20h14"></path></svg></span><span>Deposit</span>
    </a>
    <a href="/transfer/withdraw" class="sidebar-link <%= title === 'Withdraw Funds' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V7"></path><path d="m7 12 5-5 5 5"></path><path d="M5 4h14"></path></svg></span><span>Withdraw</span>
    </a>

    <div class="nb-sidebar-section nb-sidebar-section-spaced">FINANCIAL SERVICES</div>
    <a href="/airtime" class="sidebar-link <%= title === 'Airtime Recharge' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2"></rect><path d="M10 6h4"></path><circle cx="12" cy="17" r="1"></circle></svg></span><span>Airtime</span>
    </a>
    <a href="/loans" class="sidebar-link <%= title === 'Loan' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="13" rx="2"></rect><path d="M8 6V4h8v2"></path><path d="M8 13h8"></path></svg></span><span>Loans</span>
    </a>
    <a href="/grants" class="sidebar-link <%= title === 'Grants' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16"></path><path d="M5 8h14"></path><path d="M7 4h10"></path><path d="M6 20h12"></path></svg></span><span>Grants</span>
    </a>
    <a href="/refunds" class="sidebar-link <%= title === 'Refunds' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 8a8 8 0 1 0 1 5"></path><path d="M20 4v6h-6"></path></svg></span><span>Refunds</span>
    </a>
    <a href="/dashboard/notifications" class="sidebar-link <%= title === 'Notifications' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path><path d="M10 21h4"></path></svg></span><span>Secure inbox</span><% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><em class="nb-nav-count"><%= unreadCount %></em><% } %>
    </a>

    <div class="nb-sidebar-section nb-sidebar-section-spaced">ACCOUNT</div>
    <a href="/account" class="sidebar-link <%= title === 'Account' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"></circle><path d="M5 20c1-4 3.5-6 7-6s6 2 7 6"></path></svg></span><span>Bank account</span>
    </a>
    <a href="/dashboard/profile" class="sidebar-link <%= title === 'Account Center' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.8 1.8 0 0 0 .3 2l.1.1-1.5 1.5-.1-.1a1.8 1.8 0 0 0-2-.3 1.8 1.8 0 0 0-1.1 1.7V20h-2v-.1a1.8 1.8 0 0 0-1.1-1.7 1.8 1.8 0 0 0-2 .3l-.1.1-1.5-1.5.1-.1a1.8 1.8 0 0 0 .3-2A1.8 1.8 0 0 0 7.1 14H7v-2h.1a1.8 1.8 0 0 0 1.7-1.1 1.8 1.8 0 0 0-.3-2l-.1-.1 1.5-1.5.1.1a1.8 1.8 0 0 0 2-.3A1.8 1.8 0 0 0 13.1 5V4h2v1a1.8 1.8 0 0 0 1.1 1.7 1.8 1.8 0 0 0 2-.3l.1-.1 1.5 1.5-.1.1a1.8 1.8 0 0 0-.3 2 1.8 1.8 0 0 0 1.7 1.1h.1v2H21a1.8 1.8 0 0 0-1.6 1z"></path></svg></span><span>Settings</span>
    </a>
    <a href="/dashboard/security" class="sidebar-link <%= title === 'Security Center' ? 'active' : '' %>">
      <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v5c0 5-3.2 8.4-8 10-4.8-1.6-8-5-8-10V6l8-3z"></path><path d="m9 12 2 2 4-4"></path></svg></span><span>Security</span>
    </a>
  </nav>

  <a href="/logout" class="sidebar-logout nb-sidebar-logout">
    <span class="nb-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"></path><path d="m14 16 4-4-4-4"></path><path d="M9 12h9"></path></svg></span><span>Sign out</span>
  </a>
</aside>