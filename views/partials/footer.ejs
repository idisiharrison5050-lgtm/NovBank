<!-- Receipt Modal -->
<div class="receipt-modal-overlay" id="receiptModal">
  <div class="receipt-modal">
    <div class="receipt-header">
      <p class="receipt-bank-name">NovBank</p>
      <p class="receipt-title">Transaction Receipt</p>
    </div>

    <div class="receipt-amount">
      <p class="receipt-amount-value" id="receiptAmount"></p>
      <p class="receipt-amount-label">Amount</p>
      <div>
        <span class="receipt-status-badge" id="receiptStatusBadge"></span>
      </div>
    </div>

    <div class="receipt-rows">
      <div class="receipt-row">
        <span class="receipt-row-label">Reference</span>
        <span class="receipt-row-value" id="receiptRef"></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-row-label">Date</span>
        <span class="receipt-row-value" id="receiptDate"></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-row-label">Type</span>
        <span class="receipt-row-value" id="receiptType"></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-row-label">From</span>
        <span class="receipt-row-value" id="receiptFrom"></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-row-label">To</span>
        <span class="receipt-row-value" id="receiptTo"></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-row-label">Description</span>
        <span class="receipt-row-value" id="receiptDesc"></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-row-label">Category</span>
        <span class="receipt-row-value" id="receiptCat"></span>
      </div>
    </div>

    <div class="receipt-actions">
      <button class="btn btn-outline-secondary" onclick="downloadReceiptPDF()">Download PDF</button>
      <button class="btn btn-primary" onclick="closeReceipt()">Done</button>
    </div>
  </div>
</div>
<footer class="main-footer">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <p class="footer-brand">NovBank</p>
        <p class="footer-tagline">Secure. Simple. Smart.</p>
      </div>
      <div class="col-md-4">
        <p class="footer-heading">Quick Links</p>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <% if (user) { %>
            <li><a href="/dashboard">Dashboard</a></li>
            <li><a href="/logout">Logout</a></li>
          <% } else { %>
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Open Account</a></li>
          <% } %>
        </ul>
      </div>
      <div class="col-md-4">
        <p class="footer-heading">Legal</p>
        <ul class="footer-links">
          <li><a href="#">Privacy Policy</a></li>
          <li><a href="#">Terms of Service</a></li>
          <li><a href="#">Cookie Policy</a></li>
        </ul>
      </div>
    </div>
    <hr/>
    <p class="footer-copy">&copy; <%= new Date().getFullYear() %> NovBank. All rights reserved.</p>
  </div>
</footer>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
  var hamburgerBtn = document.getElementById('hamburgerBtn');
  var sidebar      = document.querySelector('.sidebar');
  var overlay      = document.getElementById('sidebarOverlay');

  if (hamburgerBtn && sidebar && overlay) {
    hamburgerBtn.addEventListener('click', function () {
      sidebar.classList.toggle('open');
      overlay.classList.toggle('open');
    });
    overlay.addEventListener('click', function () {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
    });
  }

  // Receipt modal close on backdrop click
  var receiptModal = document.getElementById('receiptModal');
  if (receiptModal) {
    receiptModal.addEventListener('click', function (e) {
      if (e.target === receiptModal) {
        receiptModal.style.display = 'none';
      }
    });
  }
  function openReceipt(data) {
  document.getElementById('receiptAmount').textContent = '€' + parseFloat(data.amount).toFixed(2);

  var statusBadge = document.getElementById('receiptStatusBadge');
  statusBadge.textContent = data.status;
  statusBadge.className   = 'receipt-status-badge receipt-status-' + data.status;

  document.getElementById('receiptRef').textContent  = data.reference  || '-';
  document.getElementById('receiptDate').textContent = data.date        || '-';
  document.getElementById('receiptType').textContent = data.type        || '-';
  document.getElementById('receiptFrom').textContent = data.from        || '-';
  document.getElementById('receiptTo').textContent   = data.to          || '-';
  document.getElementById('receiptDesc').textContent = data.description || '-';
  document.getElementById('receiptCat').textContent  = data.category    || '-';

  document.getElementById('receiptModal').classList.add('open');
}

function closeReceipt() {
  document.getElementById('receiptModal').classList.remove('open');
  var redirect = document.getElementById('receiptModal').getAttribute('data-redirect');
  if (redirect) window.location.href = redirect;
}

function downloadReceiptPDF() {
  var ref    = document.getElementById('receiptRef').textContent;
  var amount = document.getElementById('receiptAmount').textContent;
  var date   = document.getElementById('receiptDate').textContent;
  var type   = document.getElementById('receiptType').textContent;
  var from   = document.getElementById('receiptFrom').textContent;
  var to     = document.getElementById('receiptTo').textContent;
  var desc   = document.getElementById('receiptDesc').textContent;
  var cat    = document.getElementById('receiptCat').textContent;
  var status = document.getElementById('receiptStatusBadge').textContent;

  var content = [
    'NOVBANK - TRANSACTION RECEIPT',
    '==============================',
    '',
    'Reference:   ' + ref,
    'Date:        ' + date,
    'Type:        ' + type,
    'Amount:      ' + amount,
    'Status:      ' + status,
    '',
    'From:        ' + from,
    'To:          ' + to,
    'Description: ' + desc,
    'Category:    ' + cat,
    '',
    '==============================',
    'NovBank | novbank.onrender.com',
    'Generated: ' + new Date().toLocaleString()
  ].join('\n');

  var blob = new Blob([content], { type: 'text/plain' });
  var url  = URL.createObjectURL(blob);
  var a    = document.createElement('a');
  a.href     = url;
  a.download = 'receipt-' + ref + '.txt';
  a.click();
  URL.revokeObjectURL(url);
}

// Close receipt on backdrop click
var receiptModalEl = document.getElementById('receiptModal');
if (receiptModalEl) {
  receiptModalEl.addEventListener('click', function (e) {
    if (e.target === receiptModalEl) closeReceipt();
  });
}
</script>
</body>
</html>