<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/banking-flows.css?v=receive1"/>
<link rel="stylesheet" href="/css/receive.css?v=receive1"/>

<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn" aria-label="Open navigation">☰</button></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>
  <main class="dashboard-main nb-receive-page nb-flow-screen">

    <section class="nb-flow-hero">
      <div>
        <span class="nb-flow-eyebrow">RECEIVE MONEY</span>
        <h1>Get paid your way.</h1>
        <p>Share your NovBank account details for bank transfers or use your configured Bitcoin deposit address for BTC payments.</p>
      </div>
      <div class="nb-flow-balance">
        <span>ACCOUNT NUMBER</span>
        <strong><%= user.accountNumber %></strong>
        <small>NovBank receiving details</small>
      </div>
    </section>

    <div class="nb-receive-grid">
      <section class="nb-receive-card">
        <div class="nb-flow-card-head">
          <div><span>BANK TRANSFERS</span><h2>Receive by bank transfer</h2><p>Give these details to someone sending money to your NovBank account.</p></div>
          <div class="nb-flow-secure">Account details</div>
        </div>

        <div class="nb-receive-detail-grid">
          <div><span>ACCOUNT NAME</span><strong><%= user.firstName %> <%= user.lastName %></strong></div>
          <div><span>ACCOUNT NUMBER</span><div class="nb-receive-value"><strong class="mono"><%= user.accountNumber %></strong><button type="button" class="nb-inline-copy" data-copy="<%= user.accountNumber %>">Copy</button></div></div>
          <div><span>IBAN</span><div class="nb-receive-value"><strong class="mono"><%= user.bankDetails && user.bankDetails.iban ? user.bankDetails.iban : 'Not available' %></strong><% if (user.bankDetails && user.bankDetails.iban) { %><button type="button" class="nb-inline-copy" data-copy="<%= user.bankDetails.iban %>">Copy</button><% } %></div></div>
          <div><span>SWIFT / BIC</span><div class="nb-receive-value"><strong class="mono"><%= user.bankDetails && user.bankDetails.swift ? user.bankDetails.swift : 'Not available' %></strong><% if (user.bankDetails && user.bankDetails.swift) { %><button type="button" class="nb-inline-copy" data-copy="<%= user.bankDetails.swift %>">Copy</button><% } %></div></div>
          <div><span>BANK</span><strong><%= user.bankDetails && user.bankDetails.bankName ? user.bankDetails.bankName : 'NovBank' %></strong></div>
          <div><span>CURRENCY</span><strong><%= user.currency || 'EUR' %></strong></div>
        </div>

        <button type="button" class="nb-copy-details" data-copy="<%= user.accountNumber %>">Copy account number</button>
      </section>

      <section class="nb-receive-card nb-bitcoin-card">
        <div class="nb-flow-card-head">
          <div><span>CRYPTO RECEIVING</span><h2>Receive Bitcoin</h2><p>Use your configured BTC deposit address. Only send Bitcoin to this address.</p></div>
          <div class="nb-bitcoin-mark">₿</div>
        </div>

        <% if (bitcoinAddress) { %>
          <div class="nb-bitcoin-qr">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=10&data=<%= encodeURIComponent('bitcoin:' + bitcoinAddress) %>" alt="Bitcoin deposit QR code" loading="lazy"/>
          </div>
          <div class="nb-bitcoin-address">
            <span>BITCOIN ADDRESS</span>
            <div><code id="bitcoinAddress"><%= bitcoinAddress %></code><button type="button" class="nb-bitcoin-copy" data-copy="<%= bitcoinAddress %>">Copy</button></div>
          </div>
          <div class="nb-bitcoin-warning"><b>Send only BTC</b><span>Sending another cryptocurrency to this address may result in permanent loss of funds.</span></div>
        <% } else { %>
          <div class="nb-bitcoin-unconfigured">
            <div>₿</div>
            <strong>Bitcoin receiving is not configured yet</strong>
            <p>A Bitcoin deposit address must be assigned to this account before BTC can be received safely.</p>
          </div>
        <% } %>
      </section>
    </div>

    <section class="nb-receive-note">
      <b>Receiving money securely</b>
      <span>Always verify the recipient details before sharing or sending funds. NovBank will never ask you to send funds to an address through an unsolicited message.</span>
    </section>
  </main>
</div>
<div class="nb-copy-toast" role="status" aria-live="polite">Copied to clipboard</div>
<script>
(function () {
  var toast = document.querySelector('.nb-copy-toast');
  var buttons = document.querySelectorAll('[data-copy]');
  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      var value = button.getAttribute('data-copy');
      if (!value || !navigator.clipboard) return;
      navigator.clipboard.writeText(value).then(function () {
        var original = button.textContent;
        button.textContent = 'Copied';
        button.classList.add('copied');
        if (toast) {
          toast.classList.add('show');
          setTimeout(function () { toast.classList.remove('show'); }, 1500);
        }
        setTimeout(function () {
          button.textContent = original;
          button.classList.remove('copied');
        }, 1400);
      });
    });
  });
}());
</script>
<%- include('../partials/footer') %>