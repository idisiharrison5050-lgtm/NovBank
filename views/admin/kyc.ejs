<%- include('partials/admin-header') %>
<div class="admin-layout">
  <%- include('partials/admin-sidebar') %>
  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">KYC Verification</h1>
    </div>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <div class="admin-filter-row">
      <div class="admin-filter-group">
        <a href="?filter=pending"  class="admin-filter-btn <%= filter === 'pending'  ? 'active' : '' %>">Pending</a>
        <a href="?filter=approved" class="admin-filter-btn <%= filter === 'approved' ? 'active' : '' %>">Approved</a>
        <a href="?filter=declined" class="admin-filter-btn <%= filter === 'declined' ? 'active' : '' %>">Declined</a>
        <a href="?filter=all"      class="admin-filter-btn <%= filter === 'all'      ? 'active' : '' %>">All</a>
      </div>
    </div>

    <div class="admin-card">
      <% if (kycs.length === 0) { %>
        <p class="admin-empty">No KYC submissions found.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>ID Type</th>
                <th>Submitted</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% kycs.forEach(function(kyc) { %>
                <tr>
                  <td><%= kyc.user ? kyc.user.firstName + ' ' + kyc.user.lastName : 'N/A' %></td>
                  <td>@<%= kyc.user ? kyc.user.username : 'N/A' %></td>
                  <td><%= kyc.user ? kyc.user.email : 'N/A' %></td>
                  <td><%= kyc.idType.replace('_', ' ') %></td>
                  <td><%= new Date(kyc.submittedAt).toLocaleDateString('en-GB') %></td>
                  <td><span class="admin-status-badge status-<%= kyc.status %>"><%= kyc.status %></span></td>
                  <td><a href="/admin/kyc/<%= kyc._id %>" class="admin-btn-view">Review</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>
<%- include('partials/admin-footer') %>