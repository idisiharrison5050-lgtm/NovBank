<aside class="admin-sidebar">
  <div class="admin-sidebar-logo">
    <span>NovBank</span>
    <span class="admin-badge">Admin</span>
  </div>

  <nav class="admin-nav">
    <p class="admin-nav-label">Overview</p>
    <a href="/admin/dashboard" class="admin-nav-link <%= title === 'Admin Dashboard' ? 'active' : '' %>">▦ <span>Dashboard</span></a>

    <p class="admin-nav-label">Customers</p>
    <a href="/admin/users" class="admin-nav-link <%= title === 'All Users' ? 'active' : '' %>">◉ <span>Manage Users</span></a>
    <a href="/admin/kyc" class="admin-nav-link <%= title === 'KYC Verification' || title === 'KYC Detail' ? 'active' : '' %>">✓ <span>KYC Verification</span></a>
    <a href="/admin/notifications" class="admin-nav-link <%= title === 'Notifications' ? 'active' : '' %>">✉ <span>Email & Notifications</span></a>

    <p class="admin-nav-label">Money Movement</p>
    <a href="/admin/transactions" class="admin-nav-link <%= title === 'Transactions' ? 'active' : '' %>">↕ <span>Transaction History</span></a>
    <a href="/admin/transactions?filter=wire_transfer&status=all" class="admin-nav-link">↗ <span>Transfer Transactions</span></a>
    <a href="/admin/transactions?filter=deposit&status=all" class="admin-nav-link">↓ <span>User Deposits</span></a>
    <a href="/admin/refunds" class="admin-nav-link <%= title === 'Refund Management' ? 'active' : '' %>">↩ <span>Refunds</span></a>

    <p class="admin-nav-label">Credit & Benefits</p>
    <a href="/admin/grants" class="admin-nav-link <%= title === 'Grant Applications' ? 'active' : '' %>">◈ <span>Grant Applications</span></a>
    <a href="/admin/loans" class="admin-nav-link <%= title === 'Loan Requests' ? 'active' : '' %>">▣ <span>Loan Applications</span></a>
    <a href="/admin/cards" class="admin-nav-link <%= title === 'Card Requests' ? 'active' : '' %>">▤ <span>Virtual Cards</span></a>

    <p class="admin-nav-label">Administration</p>
    <a href="/admin/administrators" class="admin-nav-link <%= title === 'Administrators' ? 'active' : '' %>">♟ <span>Administrators</span></a>
    <a href="/admin/audit-log" class="admin-nav-link <%= title === 'Audit Log' ? 'active' : '' %>">◷ <span>Audit Log</span></a>
    <a href="/admin/settings" class="admin-nav-link <%= title === 'System Settings' ? 'active' : '' %>">⚙ <span>Settings</span></a>
  </nav>

  <div class="admin-sidebar-footer">
    <div class="admin-user-info">
      <p class="admin-user-name"><%= user.firstName %> <%= user.lastName %></p>
      <p class="admin-user-role"><%= user.role === 'manager' ? 'Manager' : 'Super Admin' %></p>
    </div>
    <a href="/admin/logout" class="admin-logout-btn">↪</a>
  </div>
</aside>