<%- include('partials/admin-header') %>
<div class="admin-layout">
  <%- include('partials/admin-sidebar') %>
  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <p class="admin-kicker">Money Movement</p>
        <h1 class="admin-page-title">Generate Transaction</h1>
      </div>
    </div>
    <% if (error_msg && error_msg.length) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
    <div class="admin-card" style="max-width:760px;">
      <div class="admin-card-header"><h5>Post a ledger-backed transaction</h5></div>
      <form action="/admin/generate-transaction" method="POST">
        <div class="form-group">
          <label>Customer</label>
          <select name="userId" class="form-control" required>
            <option value="">Select customer</option>
            <% users.forEach(function(u) { %>
              <option value="<%= u._id %>"><%= u.firstName %> <%= u.lastName %> — @<%= u.username %> — <%= u.accountNumber %></option>
            <% }); %>
          </select>
        </div>
        <div class="row">
          <div class="col-md-6"><div class="form-group"><label>Direction</label><select name="direction" class="form-control"><option value="credit">Credit</option><option value="debit">Debit</option></select></div></div>
          <div class="col-md-6"><div class="form-group"><label>Amount</label><input type="number" name="amount" class="form-control" min="0.01" step="0.01" required></div></div>
        </div>
        <div class="form-group"><label>Description / reference</label><input name="description" class="form-control" maxlength="180" placeholder="e.g. Approved manual adjustment" required></div>
        <div class="admin-callout">This action writes through the financial ledger and creates a transaction record. It is also recorded in the admin audit log.</div>
        <button class="btn btn-primary">Generate transaction</button>
      </form>
    </div>
  </main>
</div>
<%- include('partials/admin-footer') %>
