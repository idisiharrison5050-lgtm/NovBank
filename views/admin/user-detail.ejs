<%- include('partials/admin-header') %>

<div class="admin-layout">
  <%- include('partials/admin-sidebar') %>

  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <a href="/admin/users" class="admin-back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Users
        </a>
        <h1 class="admin-page-title"><%= targetUser.firstName %> <%= targetUser.lastName %></h1>
      </div>
    </div>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <div class="row">
      <!-- Profile Info -->
      <div class="col-md-4">
        <div class="admin-card">
          <div class="admin-profile-avatar">
            <%= targetUser.firstName.charAt(0) %><%= targetUser.lastName.charAt(0) %>
          </div>
          <h4 class="admin-profile-name"><%= targetUser.firstName %> <%= targetUser.lastName %></h4>
          <p class="admin-profile-meta">@<%= targetUser.username %></p>
          <p class="admin-profile-meta"><%= targetUser.email %></p>
          <p class="admin-profile-meta"><%= targetUser.phone %></p>

          <hr class="admin-divider"/>

          <div class="admin-detail-row">
            <span class="admin-detail-label">Account Number</span>
            <span class="admin-detail-value mono"><%= targetUser.accountNumber %></span>
          </div>
          <div class="admin-detail-row">
            <span class="admin-detail-label">Balance</span>
            <span class="admin-detail-value">€<%= targetUser.balance.toFixed(2) %></span>
          </div>
          <div class="admin-detail-row">
            <span class="admin-detail-label">Currency</span>
            <span class="admin-detail-value"><%= targetUser.currency %></span>
          </div>
          <div class="admin-detail-row">
            <span class="admin-detail-label">Status</span>
            <span class="admin-status-badge status-<%= targetUser.accountStatus %>"><%= targetUser.accountStatus %></span>
          </div>
          <div class="admin-detail-row">
            <span class="admin-detail-label">Joined</span>
            <span class="admin-detail-value"><%= new Date(targetUser.createdAt).toLocaleDateString('en-GB') %></span>
          </div>
          <% if (targetUser.address) { %>
            <div class="admin-detail-row">
              <span class="admin-detail-label">Address</span>
              <span class="admin-detail-value"><%= targetUser.address.street %>, <%= targetUser.address.city %>, <%= targetUser.address.country %></span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Actions -->
      <div class="col-md-8">

        <div class="admin-card">
          <h5 class="admin-card-title">Super Admin Profile Control</h5>
          <form action="/admin/users/<%= targetUser._id %>/update-profile" method="POST">
            <div class="row">
              <div class="col-md-6"><div class="form-group"><label>First name</label><input name="firstName" class="form-control" value="<%= targetUser.firstName %>" required></div></div>
              <div class="col-md-6"><div class="form-group"><label>Last name</label><input name="lastName" class="form-control" value="<%= targetUser.lastName %>" required></div></div>
            </div>
            <div class="row">
              <div class="col-md-6"><div class="form-group"><label>Email</label><input type="email" name="email" class="form-control" value="<%= targetUser.email %>" required></div></div>
              <div class="col-md-6"><div class="form-group"><label>Phone</label><input name="phone" class="form-control" value="<%= targetUser.phone %>" required></div></div>
            </div>
            <div class="form-group"><label>Account currency</label><input name="currency" class="form-control" value="<%= targetUser.currency || 'EUR' %>" maxlength="3"></div>
            <button class="btn btn-primary">Save profile</button>
          </form>
        </div>

        <div class="admin-card">
          <h5 class="admin-card-title">Bank Receiving Details</h5>
          <form action="/admin/users/<%= targetUser._id %>/update-bank-details" method="POST">
            <div class="row">
              <div class="col-md-6"><div class="form-group"><label>Bank name</label><input name="bankName" class="form-control" value="<%= targetUser.bankDetails && targetUser.bankDetails.bankName || 'NovBank' %>"></div></div>
              <div class="col-md-6"><div class="form-group"><label>IBAN</label><input name="iban" class="form-control" value="<%= targetUser.bankDetails && targetUser.bankDetails.iban || '' %>"></div></div>
            </div>
            <div class="row">
              <div class="col-md-4"><div class="form-group"><label>SWIFT / BIC</label><input name="swift" class="form-control" value="<%= targetUser.bankDetails && targetUser.bankDetails.swift || '' %>"></div></div>
              <div class="col-md-4"><div class="form-group"><label>Routing number</label><input name="routingNumber" class="form-control" value="<%= targetUser.bankDetails && targetUser.bankDetails.routingNumber || '' %>"></div></div>
              <div class="col-md-4"><div class="form-group"><label>Sort code</label><input name="sortCode" class="form-control" value="<%= targetUser.bankDetails && targetUser.bankDetails.sortCode || '' %>"></div></div>
            </div>
            <div class="form-group"><label>Bank address</label><input name="bankAddress" class="form-control" value="<%= targetUser.bankDetails && targetUser.bankDetails.bankAddress || '' %>"></div>
            <button class="btn btn-primary">Save bank details</button>
          </form>
        </div>

        <div class="admin-card">
          <h5 class="admin-card-title">Ledger Balance Control</h5>
          <p class="admin-danger-text">Set a target balance and provide a reason. The adjustment is recorded in the ledger and audit log.</p>
          <form action="/admin/users/<%= targetUser._id %>/adjust-balance" method="POST">
            <div class="form-inline-row">
              <input type="number" name="targetBalance" class="form-control" value="<%= targetUser.balance.toFixed(2) %>" step="0.01" min="0" required>
              <input type="text" name="reason" class="form-control" placeholder="Reason for adjustment" required>
              <button class="btn btn-warning">Apply adjustment</button>
            </div>
          </form>
        </div>

        <div class="admin-card">
          <h5 class="admin-card-title">Verification Controls</h5>
          <div class="form-inline-row">
            <form action="/admin/users/<%= targetUser._id %>/verification" method="POST"><input type="hidden" name="action" value="email"><input type="hidden" name="value" value="<%= targetUser.emailVerified ? 'false' : 'true' %>"><button class="btn btn-info"><%= targetUser.emailVerified ? 'Mark email unverified' : 'Verify email' %></button></form>
            <form action="/admin/users/<%= targetUser._id %>/verification" method="POST"><input type="hidden" name="action" value="kyc"><select name="value" class="form-control"><option value="none" <%= targetUser.kycStatus === 'none' ? 'selected' : '' %>>KYC: None</option><option value="pending" <%= targetUser.kycStatus === 'pending' ? 'selected' : '' %>>KYC: Pending</option><option value="approved" <%= targetUser.kycStatus === 'approved' ? 'selected' : '' %>>KYC: Approved</option><option value="declined" <%= targetUser.kycStatus === 'declined' ? 'selected' : '' %>>KYC: Declined</option></select><button class="btn btn-info">Apply KYC</button></form>
          </div>
        </div>

        <!-- Edit Balance -->
        <div class="admin-card">
          <h5 class="admin-card-title">Edit Balance</h5>
          <form action="/admin/users/<%= targetUser._id %>/edit-balance" method="POST" class="form-inline-row">
            <div class="form-group mb-0 mr-3" style="flex:1">
              <input type="number" name="balance" class="form-control w-100" value="<%= targetUser.balance.toFixed(2) %>" step="0.01" min="0" required/>
            </div>
            <button type="submit" class="btn btn-primary">Update Balance</button>
          </form>
        </div>
        <!-- Admin Deposit -->
      <div class="admin-card">
        <h5 class="admin-card-title">Deposit Funds into Account</h5>
        <form action="/admin/users/<%= targetUser._id %>/deposit" method="POST">
          <div class="form-group">
            <label>Amount (€)</label>
            <input type="number" name="amount" class="form-control" placeholder="0.00" step="0.01" min="0.01" required/>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Sending Bank Name</label>
                <input type="text" name="bankName" class="form-control" placeholder="e.g. Deutsche Bank" required/>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>Account Name</label>
                <input type="text" name="accountName" class="form-control" placeholder="e.g. John Doe" required/>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Account Number / IBAN</label>
                <input type="text" name="accountNumber" class="form-control" placeholder="e.g. DE89370400440532013000" required/>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>SWIFT / BIC Code (optional)</label>
                <input type="text" name="swiftCode" class="form-control" placeholder="e.g. DEUTDEDB"/>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label>Description (optional)</label>
            <input type="text" name="description" class="form-control" placeholder="e.g. Salary payment, Wire transfer credit"/>
          </div>
          <button type="submit" class="btn btn-success btn-block">Credit Account</button>
        </form>
    </div>

        <!-- Change Status -->
        <div class="admin-card">
          <h5 class="admin-card-title">Account Status</h5>
          <form action="/admin/users/<%= targetUser._id %>/status" method="POST" class="form-inline-row">
            <div class="form-group mb-0 mr-3" style="flex:1">
              <select name="status" class="form-control w-100">
                <option value="active"    <%= targetUser.accountStatus === 'active'    ? 'selected' : '' %>>Active</option>
                <option value="suspended" <%= targetUser.accountStatus === 'suspended' ? 'selected' : '' %>>Suspended</option>
                <option value="closed"    <%= targetUser.accountStatus === 'closed'    ? 'selected' : '' %>>Closed</option>
              </select>
            </div>
            <button type="submit" class="btn btn-warning">Update Status</button>
          </form>
        </div>

        <!-- Delete User -->
        <div class="admin-card admin-danger-zone">
          <h5 class="admin-card-title danger-title">Danger Zone</h5>
          <p class="admin-danger-text">Permanently delete this user and all their transaction history. This cannot be undone.</p>
          <form action="/admin/users/<%= targetUser._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this user? This is permanent.');">
            <button type="submit" class="btn btn-danger">Delete User</button>
          </form>
        </div>

        <!-- Transaction History -->
        <div class="admin-card">
          <h5 class="admin-card-title">Transaction History</h5>
          <% if (transactions.length === 0) { %>
            <p class="admin-empty">No transactions.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Description</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% transactions.forEach(function(txn) { %>
                    <tr>
                      <td><%= new Date(txn.createdAt).toLocaleDateString('en-GB') %></td>
                      <td><%= txn.type.replace('_', ' ') %></td>
                      <td>€<%= txn.amount.toFixed(2) %></td>
                      <td><%= txn.description || '-' %></td>
                      <td><span class="admin-status-badge status-<%= txn.status %>"><%= txn.status %></span></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  <section class="admin-card" style="margin-top:20px;">
  <div class="admin-card-header"><h2>Bitcoin Receiving</h2><span class="admin-status-badge <%= targetUser.bitcoinDepositAddress ? 'status-active' : 'status-suspended' %>"><%= targetUser.bitcoinDepositAddress ? 'Configured' : 'Not configured' %></span></div>
  <p style="color:#667085;font-size:13px;">Set or replace the Bitcoin deposit address used on this user's Receive Money page. Leave empty to disable Bitcoin receiving for the account.</p>
  <form action="/admin/users/<%= targetUser._id %>/bitcoin-address" method="POST">
    <div class="form-group"><label>Bitcoin deposit address</label><input type="text" name="bitcoinDepositAddress" class="form-control" value="<%= targetUser.bitcoinDepositAddress || '' %>" placeholder="bc1... or 1... / 3..."></div>
    <button type="submit" class="btn btn-primary">Save Bitcoin address</button>
  </form>
  <% if (targetUser.bitcoinDepositAddress) { %><small style="display:block;margin-top:10px;color:#98a2b3;word-break:break-all;">Current: <%= targetUser.bitcoinDepositAddress %></small><% } %>
</section>
</main>
</div>

<%- include('partials/admin-footer') %>