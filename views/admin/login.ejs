<%- include('partials/admin-header') %>

<div class="admin-auth-wrap">
  <div class="admin-auth-box">
    <div class="admin-auth-logo">NovBank</div>
    <p class="admin-auth-sub">SECURE ADMINISTRATION</p>
    <h2 class="admin-auth-title">Welcome back</h2>
    <p style="color:#667085;font-size:12px;line-height:1.6;margin:-12px 0 24px;">Access the NovBank operations console using your administrator credentials.</p>

    <% if (success_msg && success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %>
    <% if (error_msg && error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
    <% if (error && error.length > 0) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label>Email or Username</label>
        <input type="text" name="identifier" class="form-control" placeholder="Enter your admin identifier" autocomplete="username" required/>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-block admin-btn">Sign in securely</button>
    </form>

    <p style="margin:18px 0 0;color:#98a2b3;font-size:10px;text-align:center;">Authorized administrators only</p>
  </div>
</div>

<%- include('partials/admin-footer') %>