<%- include('partials/admin-header') %>

<div class="admin-auth-wrap">
  <div class="admin-auth-box">
    <div class="admin-auth-logo">NovBank</div>
    <p class="admin-auth-sub">Admin Panel</p>
    <h2 class="admin-auth-title">Sign in</h2>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label>Email or Username</label>
        <input type="text" name="identifier" class="form-control" placeholder="admin@novbank.com" required/>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" class="form-control" placeholder="••••••••" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-block admin-btn">Sign In to Admin</button>
    </form>
  </div>
</div>

<%- include('partials/admin-footer') %>