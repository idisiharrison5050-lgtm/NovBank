<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/auth.css"/>

<div class="auth-wrapper">
  <div class="auth-box">
    <div class="auth-logo">NovBank</div>
    <h2 class="auth-title">Reset Password</h2>
    <p class="auth-subtitle">Enter your new password below.</p>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <form action="/reset-password/<%= token %>" method="POST">
      <div class="form-group">
        <label>New Password</label>
        <input type="password" name="password" class="form-control" placeholder="At least 8 characters" required/>
      </div>
      <div class="form-group">
        <label>Confirm New Password</label>
        <input type="password" name="confirmPassword" class="form-control" placeholder="Repeat password" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-auth">Reset Password</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>