<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/auth.css"/>

<div class="auth-wrapper nb-auth-premium">
  <div class="auth-box">
    <div class="auth-brand-row"><div class="auth-logo">NovBank</div><span>PRIVATE BANKING</span></div>
    <div class="auth-kicker">SECURE ACCESS</div>
    <h2 class="auth-title">Welcome back</h2>
    <p class="auth-subtitle">Sign in to securely access your account, cards and banking activity.</p>

    <% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %>
    <% if (error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
    <% if (error.length > 0) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <form action="/login" method="POST">
      <div class="form-group"><label>Email or Username</label><input type="text" name="identifier" class="form-control" placeholder="Enter email or username" autocomplete="username" required/></div>
      <div class="form-group"><div class="auth-label-row"><label>Password</label><a href="/forgot-password">Forgot?</a></div><input type="password" name="password" id="loginPassword" class="form-control" placeholder="Enter password" autocomplete="current-password" required/></div>
      <% if (recaptchaSiteKey) { %>
        <div class="mb-3" id="loginRecaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
        <div class="alert alert-warning mb-3" id="loginRecaptchaError" role="alert" hidden>Security verification could not load. Please refresh the page or contact support if the problem continues.</div>
      <% } else { %>
        <div class="alert alert-warning mb-3" role="alert">Security verification is not configured for this environment. Please contact support.</div>
      <% } %>
      <button type="submit" class="btn btn-primary btn-block btn-auth">Sign in securely</button>
    </form>

    <div class="auth-security-strip"><span>✓</span><div><strong>Protected account access</strong><small>Additional verification may be required before entering your banking workspace.</small></div></div>
    <p class="auth-footer-text">Don't have an account? <a href="/register">Create your account</a></p>
    <p class="auth-footer-text"><a href="/forgot-pin">Reset transaction PIN</a></p>
    <p class="auth-home-link"><a href="/">← Back to NovBank</a></p>
  </div>
</div>

<% if (recaptchaSiteKey) { %>
<script>
(function () {
  var attempts = 0;
  var maxAttempts = 120;

  function showRecaptchaError(message) {
    var errorBox = document.getElementById('loginRecaptchaError');
    if (!errorBox) return;
    errorBox.textContent = message || 'Security verification could not load. Please refresh the page or contact support if the problem continues.';
    errorBox.hidden = false;
  }

  function renderLoginRecaptcha() {
    var widget = document.getElementById('loginRecaptcha');
    if (!widget || widget.getAttribute('data-rendered') === 'true') return;

    if (window.grecaptcha && typeof window.grecaptcha.render === 'function') {
      try {
        window.grecaptcha.render(widget, {
          sitekey: widget.getAttribute('data-sitekey')
        });
        widget.setAttribute('data-rendered', 'true');
        var errorBox = document.getElementById('loginRecaptchaError');
        if (errorBox) errorBox.hidden = true;
      } catch (err) {
        if (window.console && console.error) console.error('NovBank reCAPTCHA failed to render:', err);
        showRecaptchaError('Google reCAPTCHA could not be rendered. Check that the site key is valid and authorized for this domain.');
      }
      return;
    }

    attempts += 1;
    if (attempts < maxAttempts) {
      window.setTimeout(renderLoginRecaptcha, 250);
    } else {
      showRecaptchaError('Google reCAPTCHA did not load. Check network access and the reCAPTCHA site key configuration, then refresh the page.');
    }
  }

  renderLoginRecaptcha();
})();
</script>
<% } %>
<%- include('../partials/footer') %>
