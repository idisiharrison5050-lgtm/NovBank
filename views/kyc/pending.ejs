<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/kyc-premium.css"/>

<div class="nb-kyc-shell">
  <div class="nb-kyc-card nb-kyc-status">
    <div class="nb-kyc-icon">
      <span>◷</span>
    </div>
    <div class="nb-kyc-kicker">IDENTITY REVIEW</div>
    <h1 class="nb-kyc-title">Verification pending</h1>
    <p class="nb-kyc-sub">Your identity documents have been submitted and are currently being reviewed. You’ll receive a notification when the review is complete.</p>

    <div class="nb-kyc-steps">
      <div class="nb-kyc-step done"><div class="nb-kyc-dot"></div><span>Submitted</span></div>
      <div class="nb-kyc-line"></div>
      <div class="nb-kyc-step active"><div class="nb-kyc-dot"></div><span>Under review</span></div>
      <div class="nb-kyc-line"></div>
      <div class="nb-kyc-step"><div class="nb-kyc-dot"></div><span>Verified</span></div>
    </div>

    <p class="nb-kyc-sub">Review times can vary depending on document quality and verification volume.</p>
  </div>
</div>

<%- include('../partials/footer') %>