<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/kyc-premium.css"/>

<div class="nb-kyc-shell">
  <div class="nb-kyc-card nb-kyc-status">
    <div class="nb-kyc-icon declined">
      <span>×</span>
    </div>
    <div class="nb-kyc-kicker">IDENTITY REVIEW</div>
    <h1 class="nb-kyc-title">Verification declined</h1>

    <% if (declineReason) { %>
      <div class="nb-kyc-reason">
        <strong>Reason</strong><br>
        <%= declineReason %>
      </div>
    <% } %>

    <p class="nb-kyc-sub">Review the information above, correct your documents, and submit a new verification request.</p>
    <a href="/kyc/verify" class="btn btn-primary btn-block nb-kyc-submit">Resubmit documents</a>
  </div>
</div>

<%- include('../partials/footer') %>