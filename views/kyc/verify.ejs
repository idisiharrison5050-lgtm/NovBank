<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/kyc-premium.css"/>

<div class="nb-kyc-shell">
  <div class="nb-kyc-card">
    <div class="nb-kyc-brand">
      <img src="/images/nav.png" width="28" height="28" alt="NovBank">
      <span>NovBank</span>
    </div>

    <div class="nb-kyc-kicker">ACCOUNT SECURITY</div>
    <h1 class="nb-kyc-title">Verify your identity</h1>
    <p class="nb-kyc-sub">Complete identity verification to keep your account secure and unlock the full banking experience.</p>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <form action="/kyc/verify" method="POST" enctype="multipart/form-data">
      <div class="nb-kyc-section">DOCUMENT INFORMATION</div>

      <div class="form-group">
        <label for="idType">ID Type</label>
        <select id="idType" name="idType" class="form-control" required>
          <option value="" disabled selected>Select document type</option>
          <option value="passport">Passport</option>
          <option value="national_id">National ID Card</option>
          <option value="drivers_license">Driver's License</option>
          <option value="residence_permit">Residence Permit</option>
        </select>
      </div>

      <div class="form-group">
        <label for="idNumber">ID Number</label>
        <input id="idNumber" type="text" name="idNumber" class="form-control" placeholder="Enter your document number" required/>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <label for="dateOfIssue">Date of Issue</label>
            <input id="dateOfIssue" type="date" name="dateOfIssue" class="form-control" required/>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <label for="dateOfExpiry">Date of Expiry</label>
            <input id="dateOfExpiry" type="date" name="dateOfExpiry" class="form-control" required/>
          </div>
        </div>
      </div>

      <div class="nb-kyc-section">UPLOAD DOCUMENTS</div>

      <div class="row">
        <div class="col-md-6">
          <div class="nb-kyc-upload">
            <label for="frontImage">
              <strong>Front of ID</strong>
              <span>JPG, PNG or PDF</span>
            </label>
            <input type="file" id="frontImage" name="frontImage" accept="image/*,.pdf" required style="display:none"/>
            <p class="nb-kyc-file" id="frontName">No file chosen</p>
          </div>
        </div>

        <div class="col-md-6">
          <div class="nb-kyc-upload">
            <label for="backImage">
              <strong>Back of ID</strong>
              <span>JPG, PNG or PDF</span>
            </label>
            <input type="file" id="backImage" name="backImage" accept="image/*,.pdf" required style="display:none"/>
            <p class="nb-kyc-file" id="backName">No file chosen</p>
          </div>
        </div>
      </div>

      <div class="nb-kyc-note">
        <span>ⓘ</span>
        <span>Make sure your documents are clear, unobstructed and fully visible. Blurry or cropped images may require resubmission.</span>
      </div>

      <button type="submit" class="btn btn-primary btn-block nb-kyc-submit">Submit for verification</button>
    </form>
  </div>
</div>

<script>
  document.getElementById('frontImage').addEventListener('change', function () {
    document.getElementById('frontName').textContent = this.files[0] ? this.files[0].name : 'No file chosen';
  });
  document.getElementById('backImage').addEventListener('change', function () {
    document.getElementById('backName').textContent = this.files[0] ? this.files[0].name : 'No file chosen';
  });
</script>

<%- include('../partials/footer') %>