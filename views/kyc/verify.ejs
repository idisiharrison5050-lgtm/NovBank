<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/kyc.css"/><link rel="stylesheet" href="/css/kyc-premium.css"/>

<div class="nb-kyc-shell"><div class="nb-kyc-card">
  <div class="kyc-box">
    <div class="nb-kyc-brand"><img src="/images/nav.png" width="28" height="28" alt="NovBank">NovBank</div>
    <h1 class="nb-kyc-title">Verify Your Identity</h1>
    <p class="kyc-subtitle">To access your account, we need to verify your identity. This is required by financial regulations.</p>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <form action="/kyc/verify" method="POST" enctype="multipart/form-data">

      <div class="kyc-section-title">Document Information</div>

      <div class="form-group">
        <label>ID Type</label>
        <select name="idType" class="form-control" required>
          <option value="" disabled selected>Select document type</option>
          <option value="passport">Passport</option>
          <option value="national_id">National ID Card</option>
          <option value="drivers_license">Driver's License</option>
          <option value="residence_permit">Residence Permit</option>
        </select>
      </div>

      <div class="form-group">
        <label>ID Number</label>
        <input type="text" name="idNumber" class="form-control" placeholder="Enter your document number" required/>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <label>Date of Issue</label>
            <input type="date" name="dateOfIssue" class="form-control" required/>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <label>Date of Expiry</label>
            <input type="date" name="dateOfExpiry" class="form-control" required/>
          </div>
        </div>
      </div>

      <div class="kyc-section-title">Upload Documents</div>

      <div class="kyc-upload-grid">
        <div class="kyc-upload-box">
          <label for="frontImage">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a56db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p class="kyc-upload-label">Front of ID</p>
            <p class="kyc-upload-hint">JPG, PNG or PDF</p>
          </label>
          <input type="file" id="frontImage" name="frontImage" accept="image/*,.pdf" required style="display:none"/>
          <p class="kyc-file-name" id="frontName">No file chosen</p>
        </div>

        <div class="kyc-upload-box">
          <label for="backImage">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a56db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p class="kyc-upload-label">Back of ID</p>
            <p class="kyc-upload-hint">JPG, PNG or PDF</p>
          </label>
          <input type="file" id="backImage" name="backImage" accept="image/*,.pdf" required style="display:none"/>
          <p class="kyc-file-name" id="backName">No file chosen</p>
        </div>
      </div>

      <div class="kyc-notice">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Make sure your documents are clear, unobstructed and fully visible. Blurry or cropped images will be rejected.
      </div>

      <button type="submit" class="btn btn-primary btn-block kyc-submit-btn">Submit for Verification</button>
    </form>
  </div>
</div>

<script>
  document.getElementById('frontImage').addEventListener('change', function () {
    document.getElementById('frontName').textContent = this.files[0] ? this.files[0].name : 'No file chosen';
  });
  document.getElementById('backImage').addEventListener('change', function () {
    document.getElementById('backName').textContent = this.files[0] ? this.files[0].name : 'No file chosen';
  });
</script>

<%- include('../partials/footer') %>