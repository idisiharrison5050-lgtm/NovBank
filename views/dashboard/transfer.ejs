<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/transfer-premium.css"/>
<link rel="stylesheet" href="/css/banking-flows.css?v=wire2"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn">☰</button></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %>
<main class="dashboard-main nb-transfer-page nb-flow-screen">
  <div class="nb-transfer-switcher" aria-label="Transfer type navigation"><a href="/transfer" class="active"><span>Local transfer</span><small>NovBank</small></a><a href="/transfer/wire"><span>International</span><small>Bank transfer</small></a></div>
  <section class="nb-flow-hero"><div><span class="nb-flow-eyebrow">PAYMENTS · LOCAL TRANSFER</span><h1>Send money, simply.</h1><p>Send funds to another NovBank customer using a username, email address or account number. Review everything before you authorize the payment.</p></div><div class="nb-flow-balance"><span>AVAILABLE BALANCE</span><strong>€ <%= Number(user.balance || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><small>Available to send</small></div></section>
  <% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %><% if (error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
  <div class="nb-wire-layout nb-flow-layout">
    <section class="nb-wire-card nb-flow-form-card">
      <div class="nb-flow-card-head"><div><span>NEW TRANSFER</span><h2>Recipient & payment details</h2><p>Use a NovBank identifier and enter the amount you want to send.</p></div><div class="nb-flow-secure">Secure payment</div></div>
      <div class="nb-wire-steps"><div class="active"><b>1</b><span>Recipient</span></div><i></i><div><b>2</b><span>Payment</span></div><i></i><div><b>3</b><span>Authorize</span></div></div>
      <form id="transferForm" class="nb-premium-form" action="/transfer" method="POST">
        <div class="nb-form-section"><span>01</span><div><b>Recipient</b><small>Who should receive the funds?</small></div></div>
        <div class="form-group"><label>Username, email or account number</label><input type="text" name="identifier" class="form-control" placeholder="e.g. alex@example.com" autocomplete="off" required/></div>
        <div class="nb-form-section nb-form-section-spaced"><span>02</span><div><b>Payment details</b><small>Set the amount and describe the transfer.</small></div></div>
        <div class="form-group"><label>Amount (€)</label><div class="nb-amount-input"><span>€</span><input type="number" name="amount" class="form-control" placeholder="0.00" min="0.01" step="0.01" required/></div></div>
        <div class="form-group"><label>Category</label><select name="category" class="form-control"><option value="Transfer">Transfer</option><option value="Food">Food</option><option value="Rent">Rent</option><option value="Utilities">Utilities</option><option value="Shopping">Shopping</option><option value="Healthcare">Healthcare</option><option value="Entertainment">Entertainment</option><option value="Other">Other</option></select></div>
        <div class="form-group"><label>Description <small class="nb-optional">Optional</small></label><input type="text" name="description" class="form-control" placeholder="What is this transfer for?"/></div>
        <input type="hidden" name="transactionPin" id="transferPinInput"/>
        <div class="nb-wire-review-note"><span>✓</span><p>Your transaction PIN is requested only when you authorize the transfer.</p></div>
        <button type="button" class="nb-flow-submit" onclick="openPinModal('transferForm')">Continue to secure review <span>→</span></button>
      </form>
    </section>
    <aside class="nb-wire-aside nb-flow-aside"><span>LOCAL TRANSFER</span><h2>Move money between NovBank accounts.</h2><p>Fast account-to-account payments with a clear recipient and authorization flow.</p><div class="nb-aside-stat"><span>Available now</span><strong>€ <%= Number(user.balance || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong></div><div class="nb-aside-list"><div><b>01</b><span>Find the recipient using their NovBank details</span></div><div><b>02</b><span>Confirm amount and payment category</span></div><div><b>03</b><span>Authorize securely with your transaction PIN</span></div></div><div class="nb-aside-foot"><span>NEED A BANK ACCOUNT?</span><b>Use International to send a wire transfer.</b></div></aside>
  </div>
</main></div><%- include('../partials/footer') %>