<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/transfer-premium.css"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn">☰</button></div><div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-transfer-page">
  <div class="nb-transfer-head"><div><span>SEND MONEY</span><h1>Move money with confidence.</h1><p>Send funds to another NovBank customer using their username, email or account number.</p></div><div class="nb-transfer-balance"><small>AVAILABLE</small><strong>€ <%= Number(user.balance).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong></div></div>
  <% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %><% if (error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
  <div class="nb-transfer-layout"><div class="form-card nb-transfer-card"><div class="nb-form-intro"><span>01</span><div><h2>Transfer details</h2><p>Enter the recipient and amount below.</p></div></div><form id="transferForm" action="/transfer" method="POST"><label>Recipient<input type="text" name="identifier" placeholder="Username, email or account number" required></label><label>Amount<input type="number" name="amount" placeholder="0.00" min="0.01" step="0.01" required></label><label>Category<select name="category"><option value="Transfer">Transfer</option><option value="Food">Food</option><option value="Rent">Rent</option><option value="Utilities">Utilities</option><option value="Shopping">Shopping</option><option value="Healthcare">Healthcare</option><option value="Entertainment">Entertainment</option><option value="Other">Other</option></select></label><label>Description <span class="optional">OPTIONAL</span><input type="text" name="description" placeholder="What is this transfer for?"></label><input type="hidden" name="transactionPin" id="transferPinInput"><button type="button" class="nb-send-button" onclick="openPinModal('transferForm')">Review & send</button></form></div><aside class="nb-transfer-side"><div><span>SECURITY</span><h3>Your transaction PIN protects transfers.</h3><p>You'll confirm the transaction before funds are moved.</p></div><a href="/transfer/wire">Need another bank? <b>Use a wire transfer →</b></a></aside></div>
</main></div><%- include('../partials/footer') %>