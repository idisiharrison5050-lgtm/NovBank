<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>

<!-- Mobile topbar -->
<div class="mobile-topbar">
  <span class="mobile-logo">NovBank</span>
  <button class="hamburger-btn" id="hamburgerBtn">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</div>

<!-- Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <main class="dashboard-main">
    <div class="dash-topbar">
      <h1 class="dash-greeting">Send Money</h1>
    </div>

    <div class="form-card">
      <p class="form-card-sub">Available Balance: <strong>€ <%= user.balance.toFixed(2) %></strong></p>

      <% if (success_msg.length > 0) { %>
        <div class="alert alert-success"><%= success_msg %></div>
      <% } %>
      <% if (error_msg.length > 0) { %>
        <div class="alert alert-danger"><%= error_msg %></div>
      <% } %>

      <form class="transferForm" action="/transfer" method="POST">
        <div class="form-group">
          <label>Recipient (Username, Email, or Account Number)</label>
          <input type="text" name="identifier" class="form-control" placeholder="e.g. johndoe or EU1234567890" required/>
        </div>
        <div class="form-group">
          <label>Amount (€)</label>
          <input type="number" name="amount" class="form-control" placeholder="0.00" min="0.01" step="0.01" required/>
        </div>
        <div class="form-group">
          <label>Category</label>
          <select name="category" class="form-control">
            <option value="Transfer">Transfer</option>
            <option value="Food">Food</option>
            <option value="Rent">Rent</option>
            <option value="Utilities">Utilities</option>
            <option value="Shopping">Shopping</option>
            <option value="Healthcare">Healthcare</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Description (optional)</label>
          <input type="text" name="description" class="form-control" placeholder="e.g. Rent for June"/>
        </div>
        <div>
          <input type="hidden" name="transactionPin" id="transferPinInput"/>
        </div>
        <button type="button" class="btn btn-primary btn-block" onclick="openPinModal('transferForm')">Send Money</button>
      </form>

      <div class="alt-transfer-link">
        Want to send to another bank? <a href="/transfer/wire">Use Wire Transfer</a>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>