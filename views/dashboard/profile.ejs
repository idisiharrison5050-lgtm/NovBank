<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/><link rel="stylesheet" href="/css/account-center.css"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn" aria-label="Open navigation"><span></span><span></span><span></span></button></div><div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-account-center">
<div class="nb-account-hero"><div><span class="nb-account-label">ACCOUNT CENTER</span><h1>My account</h1><p>Manage your profile, banking details and security.</p></div><span class="nb-account-badge"><%= user.accountStatus.charAt(0).toUpperCase()+user.accountStatus.slice(1) %> account</span></div>
<% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %><% if (error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
<div class="nb-account-grid">
<section class="nb-account-card nb-profile-card"><div class="nb-profile-top"><div class="nb-profile-avatar" aria-hidden="true"><%= (user.firstName || "N").charAt(0).toUpperCase() %><%= (user.lastName || "").charAt(0).toUpperCase() %></div><div class="nb-profile-identity"><span class="nb-account-label">PROFILE OVERVIEW</span><div class="nb-account-name"><%= user.firstName %> <%= user.lastName %></div><div class="nb-account-muted">@<%= user.username %> · <%= user.email %></div></div></div><div class="nb-profile-divider"></div><div class="nb-account-details"><div class="nb-account-detail"><span>Phone</span><b><%= user.phone || 'Not provided' %></b></div><div class="nb-account-detail"><span>Account number</span><div class="nb-detail-copy"><b class="nb-copy-value"><%= user.accountNumber %></b><button type="button" class="nb-copy-control" data-copy="<%= user.accountNumber %>">Copy</button></div></div><div class="nb-account-detail"><span>IBAN</span><div class="nb-detail-copy"><b class="nb-copy-value"><%= user.bankDetails && user.bankDetails.iban ? user.bankDetails.iban : 'Not available' %></b><% if (user.bankDetails && user.bankDetails.iban) { %><button type="button" class="nb-copy-control" data-copy="<%= user.bankDetails.iban %>">Copy</button><% } %></div></div><div class="nb-account-detail"><span>SWIFT</span><div class="nb-detail-copy"><b class="nb-copy-value"><%= user.bankDetails && user.bankDetails.swift ? user.bankDetails.swift : 'Not available' %></b><% if (user.bankDetails && user.bankDetails.swift) { %><button type="button" class="nb-copy-control" data-copy="<%= user.bankDetails.swift %>">Copy</button><% } %></div></div><div class="nb-account-detail"><span>Bank</span><b><%= user.bankDetails && user.bankDetails.bankName ? user.bankDetails.bankName : 'NovBank' %></b></div></div></section>
<section class="nb-account-card dark"><span class="nb-account-label">SECURITY STATUS</span><div class="nb-account-name"><%= user.isVerified ? 'Account verified' : 'Verification required' %></div><div class="nb-account-muted">Security controls available on your account.</div><div class="nb-security-list"><div class="nb-security-item <%= user.emailVerified ? 'ok' : 'pending' %>"><b>Email verification</b><span><%= user.emailVerified ? 'Verified' : 'Action required' %></span></div><div class="nb-security-item <%= user.pinSet ? 'ok' : 'pending' %>"><b>Transaction PIN</b><span><%= user.pinSet ? 'Configured' : 'Not configured' %></span></div><div class="nb-security-item <%= user.kycStatus === 'approved' ? 'ok' : 'pending' %>"><b>Identity verification</b><span><%= user.kycStatus %></span></div></div></section>
</div>
<section class="nb-account-card nb-account-form nb-upgrade-card" aria-labelledby="account-upgrade-title"><div class="nb-upgrade-mark" aria-hidden="true">↗</div><div class="nb-upgrade-content"><span class="nb-account-label">ACCOUNT BENEFITS</span><h2 id="account-upgrade-title">Upgrade your account</h2><p class="nb-account-muted">Complete identity verification to help unlock access to more NovBank features. Your request will be reviewed before verification is approved.</p><div class="nb-upgrade-status"><span class="nb-upgrade-status-dot <%= user.kycStatus === 'approved' ? 'is-approved' : user.kycStatus === 'pending' ? 'is-pending' : user.kycStatus === 'declined' ? 'is-declined' : '' %>"></span><span><%= user.kycStatus === 'approved' ? 'Identity verified' : user.kycStatus === 'pending' ? 'Verification under review' : user.kycStatus === 'declined' ? 'Verification needs attention' : 'Identity verification not started' %></span></div></div><div class="nb-upgrade-action"><% if (user.kycStatus === 'approved') { %><span class="nb-upgrade-complete">✓ Verified</span><% } else if (user.kycStatus === 'pending') { %><a class="nb-account-button" href="/kyc/pending">Check status</a><% } else if (user.kycStatus === 'declined') { %><a class="nb-account-button" href="/kyc/declined">Review and resubmit</a><% } else { %><a class="nb-account-button" href="/kyc/verify">Start upgrade</a><% } %></div></section>
<div class="nb-account-card nb-account-form" id="currency-settings">
<h2>Account currency</h2>
<p class="nb-account-muted">Choose the currency you want to use for your account and future transactions.</p>
<form action="/account/update-currency" method="POST">
<label for="accountCurrency">Preferred currency
<select id="accountCurrency" name="currency" required>
<% currencies.forEach(function (currency) { %>
<option value="<%= currency.code %>" <%= (user.currency || 'EUR') === currency.code ? 'selected' : '' %>><%= currency.code %> — <%= currency.name %> (<%= currency.symbol %>)</option>
<% }); %>
</select>
</label>
<button class="nb-account-button" type="submit">Save currency</button>
</form>
</div>
<section class="nb-account-card nb-account-form nb-action-card" aria-labelledby="contact-info-title"><div class="nb-action-card-icon" aria-hidden="true">✉</div><div class="nb-action-card-copy"><h2 id="contact-info-title">Contact information</h2><p class="nb-account-muted">View or update your phone number and address details in a secure panel.</p></div><button class="nb-account-button" type="button" data-modal-open="contactInfoModal">View contact information</button></section>
<div class="nb-account-modal" id="contactInfoModal" hidden><div class="nb-account-modal-backdrop" data-modal-close></div><section class="nb-account-modal-panel" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title" tabindex="-1"><div class="nb-account-modal-header"><div><span class="nb-account-label">PERSONAL DETAILS</span><h2 id="contact-modal-title">Contact information</h2><p class="nb-account-muted">Confirm your current password to save changes.</p></div><button class="nb-account-modal-close" type="button" aria-label="Close dialog" data-modal-close>×</button></div><form action="/account/update-profile" method="POST"><label>Phone<input type="tel" name="phone" value="<%= user.phone || '' %>"/></label><label>Street address<input type="text" name="street" value="<%= user.address ? user.address.street : '' %>"/></label><label>City<input type="text" name="city" value="<%= user.address ? user.address.city : '' %>"/></label><label>Zip code<input type="text" name="zip" value="<%= user.address ? user.address.zip : '' %>"/></label><label>Country<input type="text" name="country" value="<%= user.address ? user.address.country : '' %>"/></label><label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required/></label><button class="nb-account-button" type="submit">Save changes</button></form></section></div>
<div class="nb-account-security-grid"><section class="nb-account-card nb-account-form nb-action-card" id="pin" aria-labelledby="pin-action-title"><div class="nb-action-card-icon nb-action-card-icon-security" aria-hidden="true">⌑</div><div class="nb-action-card-copy"><span class="nb-account-label">TRANSACTION SECURITY</span><h2 id="pin-action-title"><%= user.pinSet ? 'Change transaction PIN' : 'Set transaction PIN' %></h2><p class="nb-account-muted">Update your 4-digit transaction PIN in a secure pop-up. Your current PIN is required when one is already set.</p></div><button class="nb-account-button" type="button" data-modal-open="changePinModal"><%= user.pinSet ? 'Change PIN' : 'Set PIN' %></button></section>
<div class="nb-account-modal" id="changePinModal" hidden><div class="nb-account-modal-backdrop" data-modal-close></div><section class="nb-account-modal-panel" role="dialog" aria-modal="true" aria-labelledby="pin-modal-title" tabindex="-1"><div class="nb-account-modal-header"><div><span class="nb-account-label">TRANSACTION SECURITY</span><h2 id="pin-modal-title"><%= user.pinSet ? 'Change transaction PIN' : 'Set transaction PIN' %></h2><p class="nb-account-muted">Enter and confirm your new 4-digit PIN.</p></div><button class="nb-account-modal-close" type="button" aria-label="Close dialog" data-modal-close>×</button></div><form action="/change-pin" method="POST"><% if (user.pinSet) { %><label>Current PIN<input type="password" name="currentPin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" minlength="4" autocomplete="off" required/></label><% } %><label>New PIN<input type="password" name="newPin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" minlength="4" autocomplete="new-password" required/></label><label>Confirm PIN<input type="password" name="confirmPin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" minlength="4" autocomplete="new-password" required/></label><button class="nb-account-button" type="submit"><%= user.pinSet ? 'Save new PIN' : 'Set PIN' %></button></form></section></div><section class="nb-account-card nb-account-form nb-action-card" aria-labelledby="reset-pin-action-title"><div class="nb-action-card-icon nb-action-card-icon-security" aria-hidden="true">↻</div><div class="nb-action-card-copy"><span class="nb-account-label">ACCOUNT ACCESS</span><h2 id="reset-pin-action-title">Reset your PIN</h2><p class="nb-account-muted">Forgot your transaction PIN? Verify your account password and set a new PIN in a secure pop-up.</p></div><button class="nb-account-button secondary" type="button" data-modal-open="resetPinModal">Reset PIN</button></section><div class="nb-account-modal" id="resetPinModal" hidden><div class="nb-account-modal-backdrop" data-modal-close></div><section class="nb-account-modal-panel" role="dialog" aria-modal="true" aria-labelledby="reset-pin-modal-title" tabindex="-1"><div class="nb-account-modal-header"><div><span class="nb-account-label">ACCOUNT ACCESS</span><h2 id="reset-pin-modal-title">Reset your PIN</h2><p class="nb-account-muted">Verify your account password, then enter and confirm your new 4-digit PIN.</p></div><button class="nb-account-modal-close" type="button" aria-label="Close dialog" data-modal-close>×</button></div><form action="/reset-pin" method="POST"><label>Account password<input type="password" name="password" autocomplete="current-password" required/></label><label>New PIN<input type="password" name="newPin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" minlength="4" autocomplete="new-password" required/></label><label>Confirm PIN<input type="password" name="confirmPin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" minlength="4" autocomplete="new-password" required/></label><button class="nb-account-button secondary" type="submit">Reset PIN</button></form></section></div></div><div class="nb-account-card nb-account-form">
  <span class="nb-account-label">USAGE LIMITS</span>
  <h2>Your account limits</h2>
  <p class="nb-account-muted">These limits are set by NovBank operations and apply to protected money movement.</p>
  <div class="nb-account-details">
    <div class="nb-account-detail"><span>Daily transfers</span><b>€<%= Number(user.accountLimits && user.accountLimits.dailyTransfer || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></b></div>
    <div class="nb-account-detail"><span>Monthly transfers</span><b>€<%= Number(user.accountLimits && user.accountLimits.monthlyTransfer || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></b></div>
    <div class="nb-account-detail"><span>Card spending</span><b>€<%= Number(user.accountLimits && user.accountLimits.cardSpending || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></b></div>
  </div>
</div>
<section class="nb-account-card nb-account-form nb-action-card" id="password" aria-labelledby="password-action-title"><div class="nb-action-card-icon nb-action-card-icon-security" aria-hidden="true">⌑</div><div class="nb-action-card-copy"><span class="nb-account-label">ACCOUNT ACCESS</span><h2 id="password-action-title">Password</h2><p class="nb-account-muted">Update your login password securely. Your current password is required to confirm the change.</p></div><button class="nb-account-button" type="button" data-modal-open="updatePasswordModal">Update password</button></section><div class="nb-account-modal" id="updatePasswordModal" hidden><div class="nb-account-modal-backdrop" data-modal-close></div><section class="nb-account-modal-panel" role="dialog" aria-modal="true" aria-labelledby="update-password-modal-title" tabindex="-1"><div class="nb-account-modal-header"><div><span class="nb-account-label">ACCOUNT ACCESS</span><h2 id="update-password-modal-title">Update password</h2><p class="nb-account-muted">Choose a strong password with at least 8 characters.</p></div><button class="nb-account-modal-close" type="button" aria-label="Close dialog" data-modal-close>×</button></div><form action="/account/change-password" method="POST"><label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required/></label><label>New password<input type="password" name="newPassword" autocomplete="new-password" minlength="8" required/></label><label>Confirm new password<input type="password" name="confirmNew" autocomplete="new-password" minlength="8" required/></label><button class="nb-account-button" type="submit">Save new password</button></form></section></div>
</main></div>
<script>
(function () {
  var modalOpeners = document.querySelectorAll('[data-modal-open]');
  var activeModal = null;
  var lastFocused = null;
  modalOpeners.forEach(function (opener) {
    opener.addEventListener('click', function () {
      var modal = document.getElementById(opener.getAttribute('data-modal-open'));
      if (!modal) return;
      lastFocused = opener;
      activeModal = modal;
      modal.hidden = false;
      document.body.classList.add('nb-modal-open');
      var panel = modal.querySelector('.nb-account-modal-panel');
      if (panel) panel.focus();
      var firstField = modal.querySelector('input');
      if (firstField) firstField.focus();
    });
  });
  document.querySelectorAll('.nb-account-modal [data-modal-close]').forEach(function (closer) {
    closer.addEventListener('click', function () {
      if (!activeModal) return;
      activeModal.hidden = true;
      activeModal = null;
      document.body.classList.remove('nb-modal-open');
      if (lastFocused) lastFocused.focus();
    });
  });
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && activeModal) {
      activeModal.hidden = true;
      activeModal = null;
      document.body.classList.remove('nb-modal-open');
      if (lastFocused) lastFocused.focus();
    }
  });
    var buttons = document.querySelectorAll('.nb-copy-control');
  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      var value = button.getAttribute('data-copy');
      if (!value || !navigator.clipboard) return;
      navigator.clipboard.writeText(value).then(function () {
        var original = button.textContent;
        button.textContent = 'Copied';
        button.classList.add('copied');
        setTimeout(function () {
          button.textContent = original;
          button.classList.remove('copied');
        }, 1400);
      });
    });
  });
}());
</script>

<%- include('../partials/footer') %>