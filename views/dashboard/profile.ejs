<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/><link rel="stylesheet" href="/css/account-center.css"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn" aria-label="Open navigation"><span></span><span></span><span></span></button></div><div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-account-center">
<div class="nb-account-hero"><div><span class="nb-account-label">ACCOUNT CENTER</span><h1>My account</h1><p>Manage your profile, banking details and security.</p></div><span class="nb-account-badge"><%= user.accountStatus.charAt(0).toUpperCase()+user.accountStatus.slice(1) %> account</span></div>
<% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %><% if (error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
<div class="nb-account-grid">
<section class="nb-account-card"><span class="nb-account-label">PROFILE</span><div class="nb-account-name"><%= user.firstName %> <%= user.lastName %></div><div class="nb-account-muted">@<%= user.username %> · <%= user.email %></div><div class="nb-account-details"><div class="nb-account-detail"><span>Phone</span><b><%= user.phone || 'Not provided' %></b></div><div class="nb-account-detail"><span>Account number</span><div class="nb-detail-copy"><b class="nb-copy-value"><%= user.accountNumber %></b><button type="button" class="nb-copy-control" data-copy="<%= user.accountNumber %>">Copy</button></div></div><div class="nb-account-detail"><span>IBAN</span><div class="nb-detail-copy"><b class="nb-copy-value"><%= user.bankDetails && user.bankDetails.iban ? user.bankDetails.iban : 'Not available' %></b><% if (user.bankDetails && user.bankDetails.iban) { %><button type="button" class="nb-copy-control" data-copy="<%= user.bankDetails.iban %>">Copy</button><% } %></div></div><div class="nb-account-detail"><span>SWIFT</span><div class="nb-detail-copy"><b class="nb-copy-value"><%= user.bankDetails && user.bankDetails.swift ? user.bankDetails.swift : 'Not available' %></b><% if (user.bankDetails && user.bankDetails.swift) { %><button type="button" class="nb-copy-control" data-copy="<%= user.bankDetails.swift %>">Copy</button><% } %></div></div><div class="nb-account-detail"><span>Bank</span><b><%= user.bankDetails && user.bankDetails.bankName ? user.bankDetails.bankName : 'NovBank' %></b></div></div></section>
<section class="nb-account-card dark"><span class="nb-account-label">SECURITY STATUS</span><div class="nb-account-name"><%= user.isVerified ? 'Account verified' : 'Verification required' %></div><div class="nb-account-muted">Security controls available on your account.</div><div class="nb-security-list"><div class="nb-security-item <%= user.emailVerified ? 'ok' : 'pending' %>"><b>Email verification</b><span><%= user.emailVerified ? 'Verified' : 'Action required' %></span></div><div class="nb-security-item <%= user.pinSet ? 'ok' : 'pending' %>"><b>Transaction PIN</b><span><%= user.pinSet ? 'Configured' : 'Not configured' %></span></div><div class="nb-security-item <%= user.kycStatus === 'approved' ? 'ok' : 'pending' %>"><b>Identity verification</b><span><%= user.kycStatus %></span></div></div></section>
</div>
<div class="nb-account-card nb-account-form" id="currency-settings">
<h2>Account currency</h2>
<p class="nb-account-muted">Choose the currency used for your account and future transactions. For security, currency changes are available only when your balance is zero; existing funds are never silently converted.</p>
<form action="/account/update-currency" method="POST">
<label for="accountCurrency">Preferred currency
<select id="accountCurrency" name="currency" required>
<% currencies.forEach(function (currency) { %>
<option value="<%= currency.code %>" <%= (user.currency || 'EUR') === currency.code ? 'selected' : '' %>><%= currency.code %> — <%= currency.name %> (<%= currency.symbol %>)</option>
<% }); %>
</select>
</label>
<label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required/></label>
<button class="nb-account-button" type="submit">Save currency</button>
</form>
</div>
<div class="nb-account-card nb-account-form"><h2>Contact information</h2><p class="nb-account-muted">For your protection, confirm your current password before changing contact or address details.</p><form action="/account/update-profile" method="POST"><label>Phone<input type="tel" name="phone" value="<%= user.phone %>"/></label><label>Street address<input type="text" name="street" value="<%= user.address ? user.address.street : '' %>"/></label><label>City<input type="text" name="city" value="<%= user.address ? user.address.city : '' %>"/></label><label>Zip code<input type="text" name="zip" value="<%= user.address ? user.address.zip : '' %>"/></label><label>Country<input type="text" name="country" value="<%= user.address ? user.address.country : '' %>"/></label><label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required/></label><button class="nb-account-button" type="submit">Save changes</button></form></div>
<div class="nb-account-security-grid"><div class="nb-account-card nb-account-form" id="pin"><span class="nb-account-label">TRANSACTION SECURITY</span><h2><%= user.pinSet ? 'Change transaction PIN' : 'Set transaction PIN' %></h2><p class="nb-account-muted">Your PIN is required before protected money movement actions.</p><form action="/change-pin" method="POST"><% if (user.pinSet) { %><label>Current PIN<input type="password" name="currentPin" inputmode="numeric" maxlength="4" autocomplete="off" required/></label><% } %><label>New PIN<input type="password" name="newPin" inputmode="numeric" maxlength="4" autocomplete="new-password" required/></label><label>Confirm PIN<input type="password" name="confirmPin" inputmode="numeric" maxlength="4" autocomplete="new-password" required/></label><button class="nb-account-button" type="submit"><%= user.pinSet ? 'Change PIN' : 'Set PIN' %></button></form></div><div class="nb-account-card nb-account-form"><span class="nb-account-label">ACCOUNT ACCESS</span><h2>Reset your PIN</h2><p class="nb-account-muted">If you no longer know your PIN, verify your account password to create a new one.</p><form action="/reset-pin" method="POST"><label>Account password<input type="password" name="password" autocomplete="current-password" required/></label><label>New PIN<input type="password" name="newPin" inputmode="numeric" maxlength="4" autocomplete="new-password" required/></label><label>Confirm PIN<input type="password" name="confirmPin" inputmode="numeric" maxlength="4" autocomplete="new-password" required/></label><button class="nb-account-button secondary" type="submit">Reset PIN</button></form></div></div><div class="nb-account-card nb-account-form">
  <span class="nb-account-label">USAGE LIMITS</span>
  <h2>Your account limits</h2>
  <p class="nb-account-muted">These limits are set by NovBank operations and apply to protected money movement.</p>
  <div class="nb-account-details">
    <div class="nb-account-detail"><span>Daily transfers</span><b>€<%= Number(user.accountLimits && user.accountLimits.dailyTransfer || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></b></div>
    <div class="nb-account-detail"><span>Monthly transfers</span><b>€<%= Number(user.accountLimits && user.accountLimits.monthlyTransfer || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></b></div>
    <div class="nb-account-detail"><span>Card spending</span><b>€<%= Number(user.accountLimits && user.accountLimits.cardSpending || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></b></div>
  </div>
</div>
<div class="nb-account-card nb-account-form" id="password"><h2>Password</h2><p class="nb-account-muted">Changing your password rotates your login session and requires fresh transaction authorization.</p><form action="/account/change-password" method="POST"><label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required/></label><label>New password<input type="password" name="newPassword" autocomplete="new-password" minlength="8" required/></label><label>Confirm new password<input type="password" name="confirmNew" autocomplete="new-password" minlength="8" required/></label><button class="nb-account-button" type="submit">Update password</button></form></div>
</main></div>
<script>
(function () {
  var buttons = document.querySelectorAll('.nb-copy-control');
  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      var value = button.getAttribute('data-copy');
      if (!value || !navigator.clipboard) return;
      navigator.clipboard.writeText(value).then(function () {
        var original = button.textContent;
        button.textContent = 'Copied';
        button.classList.add('copied');
        setTimeout(function () {
          button.textContent = original;
          button.classList.remove('copied');
        }, 1400);
      });
    });
  });
}());
</script>
<%- include('../partials/footer') %>