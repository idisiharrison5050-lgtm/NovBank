<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<!-- Mobile topbar -->
<div class="mobile-topbar">
  <span class="mobile-logo">NovBank</span>
  <button class="hamburger-btn" id="hamburgerBtn">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</div>

<!-- Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<link rel="stylesheet" href="/css/dashboard.css"/>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <main class="dashboard-main">
    <div class="dash-topbar">
      <h1 class="dash-greeting">My Profile</h1>
    </div>

    <% if (success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <!-- Account Info Card -->
    <div class="profile-info-card">
      <div class="profile-avatar-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#1a56db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div>
        <h3 class="profile-name"><%= user.firstName %> <%= user.lastName %></h3>
        <p class="profile-meta">@<%= user.username %> &bull; <%= user.email %></p>
        <p class="profile-meta">Account: <strong><%= user.accountNumber %></strong></p>
      </div>
    </div>

    <!-- Update Profile -->
    <div class="form-card">
      <h5 class="form-section-heading">Update Contact Information</h5>
      <form action="/account/update-profile" method="POST">
        <div class="form-group">
          <label>Phone Number</label>
          <input type="tel" name="phone" class="form-control" value="<%= user.phone %>"/>
        </div>
        <div class="form-group">
          <label>Street Address</label>
          <input type="text" name="street" class="form-control" value="<%= user.address ? user.address.street : '' %>"/>
        </div>
        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label>City</label>
              <input type="text" name="city" class="form-control" value="<%= user.address ? user.address.city : '' %>"/>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label>Zip Code</label>
              <input type="text" name="zip" class="form-control" value="<%= user.address ? user.address.zip : '' %>"/>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label>Country</label>
          <input type="text" name="country" class="form-control" value="<%= user.address ? user.address.country : '' %>"/>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </form>
    </div>

    <!-- Change Password -->
    <div class="form-card">
      <h5 class="form-section-heading">Change Password</h5>
      <form action="/account/change-password" method="POST">
        <div class="form-group">
          <label>Current Password</label>
          <input type="password" name="currentPassword" class="form-control" required/>
        </div>
        <div class="form-group">
          <label>New Password</label>
          <input type="password" name="newPassword" class="form-control" required/>
        </div>
        <div class="form-group">
          <label>Confirm New Password</label>
          <input type="password" name="confirmNew" class="form-control" required/>
        </div>
        <button type="submit" class="btn btn-primary">Update Password</button>
      </form>
    </div>
    <!-- Set / Change PIN -->
  <div class="form-card">
  <h5 class="form-section-heading"><%= user.pinSet ? 'Change PIN' : 'Set Transaction PIN' %></h5>
  <% if (user.pinSet) { %>
    <form action="/change-pin" method="POST">
      <div class="form-group">
        <label>Current PIN</label>
        <input type="password" name="currentPin" class="form-control" maxlength="4" inputmode="numeric" required/>
      </div>
      <div class="form-group">
        <label>New PIN</label>
        <input type="password" name="newPin" class="form-control" maxlength="4" inputmode="numeric" required/>
      </div>
      <div class="form-group">
        <label>Confirm New PIN</label>
        <input type="password" name="confirmPin" class="form-control" maxlength="4" inputmode="numeric" required/>
      </div>
      <button type="submit" class="btn btn-primary">Change PIN</button>
    </form>
    <hr style="border-color:#f1f5f9; margin: 20px 0;"/>
    <h5 class="form-section-heading">Reset PIN with Password</h5>
    <form action="/reset-pin" method="POST">
      <div class="form-group">
        <label>Account Password</label>
        <input type="password" name="password" class="form-control" required/>
      </div>
      <div class="form-group">
        <label>New PIN</label>
        <input type="password" name="newPin" class="form-control" maxlength="4" inputmode="numeric" required/>
      </div>
      <div class="form-group">
        <label>Confirm New PIN</label>
        <input type="password" name="confirmPin" class="form-control" maxlength="4" inputmode="numeric" required/>
      </div>
      <button type="submit" class="btn btn-warning">Reset PIN</button>
    </form>
  <% } else { %>
    <p style="font-size:0.88rem; color:#64748b; margin-bottom:16px;">You have not set a transaction PIN yet. Set one to enable transfers.</p>
    <a href="/set-pin" class="btn btn-primary">Set PIN Now</a>
    <% } %>
  </div>  
  </main>
</div>

<%- include('../partials/footer') %>