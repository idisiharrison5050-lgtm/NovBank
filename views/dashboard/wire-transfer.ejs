<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/><link rel="stylesheet" href="/css/funding-premium.css"/>
<!-- Mobile topbar -->
<div class="mobile-topbar">
  <span class="mobile-logo">NovBank</span>
  <button class="hamburger-btn" id="hamburgerBtn">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</div>

<!-- Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <main class="dashboard-main nb-wire-page">
    <div class="nb-funding-head"><div><span class="nb-funding-kicker">INTERNATIONAL PAYMENTS</span><h1>Wire transfer</h1><p>Send funds using recipient bank details and review the information before confirming.</p></div></div>

    <div class="form-card">
      <p class="form-card-sub">Available Balance: <strong>€ <%= user.balance.toFixed(2) %></strong></p>
      <div class="wire-notice">
        Wire transfers are processed within 1-3 business days.
      </div>

      <% if (success_msg.length > 0) { %>
        <div class="alert alert-success"><%= success_msg %></div>
      <% } %>
      <% if (error_msg.length > 0) { %>
        <div class="alert alert-danger"><%= error_msg %></div>
      <% } %>

      <form id="wireForm" class="wireForm" action="/transfer/wire" method="POST">
        <h5 class="form-section-heading">Recipient Details</h5>
        <div class="form-group">
          <label>Recipient Full Name</label>
          <input type="text" name="recipientName" class="form-control" placeholder="John Doe" required/>
        </div>
        <div class="form-group">
          <label>IBAN</label>
          <input type="text" name="iban" class="form-control" placeholder="DE89370400440532013000" required/>
        </div>
        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label>BIC / SWIFT Code</label>
              <input type="text" name="bic" class="form-control" placeholder="COBADEFFXXX" required/>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label>Bank Name</label>
              <input type="text" name="bankName" class="form-control" placeholder="Commerzbank" required/>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label>Bank Country</label>
          <input type="text" name="bankCountry" class="form-control" placeholder="Germany" required/>
        </div>

        <h5 class="form-section-heading">Transfer Details</h5>
        <div class="form-group">
          <label>Amount (€)</label>
          <input type="number" name="amount" class="form-control" placeholder="0.00" min="0.01" step="0.01" required/>
        </div>
        <div class="form-group">
          <label>Category</label>
          <select name="category" class="form-control">
            <option value="Transfer">Transfer</option>
            <option value="Rent">Rent</option>
            <option value="Utilities">Utilities</option>
            <option value="Shopping">Shopping</option>
            <option value="Healthcare">Healthcare</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Reference (optional)</label>
          <input type="text" name="reference" class="form-control" placeholder="e.g. Invoice #1234"/>
        </div>
        <div class="form-group">
          <label>Description (optional)</label>
          <input type="text" name="description" class="form-control" placeholder="Short note about this transfer"/>
        </div>
          <input type="hidden" name="transactionPin" id="wirePinInput"/>

        <button type="button" class="btn btn-primary btn-block" onclick="openPinModal('wireForm')">Submit Wire Transfer</button>
      </form>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>