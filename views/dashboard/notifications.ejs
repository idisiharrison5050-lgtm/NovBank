<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/><link rel="stylesheet" href="/css/account-center.css"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn" aria-label="Open navigation"><span></span><span></span><span></span></button></div><div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-account-center">
<div class="nb-account-hero"><div><span class="nb-account-label">SECURE INBOX</span><h1>Notifications</h1><p>Important updates and account activity in one place.</p></div></div>
<% if (notifications.length === 0) { %><div class="nb-empty-account"><div class="nb-empty-inbox-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z"></path><path d="m4 7 8 6 8-6"></path></svg></div><strong>No notifications yet.</strong><div>Important account updates will appear here.</div></div><% } else { %><div class="nb-notification-center"><% notifications.forEach(function(notif) { %><article class="nb-notification <%= notif.isRead ? '' : 'unread' %>"><div class="nb-notification-top"><b><%= notif.title %></b><span><%= new Date(notif.createdAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></span></div><p><%= notif.message %></p></article><% }); %></div><% } %>
</main></div><%- include('../partials/footer') %>