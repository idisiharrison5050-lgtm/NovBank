<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>

<div class="mobile-topbar">
  <span class="mobile-logo">NovBank</span>
  <button class="hamburger-btn" id="hamburgerBtn">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
</div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <main class="dashboard-main">
    <div class="dash-topbar">
      <h1 class="dash-greeting">Receipt</h1>
    </div>

    <div class="receipt-page-wrap">
      <div class="receipt-page-card">
        <div class="receipt-header">
          <p class="receipt-bank-name">NovBank</p>
          <p class="receipt-title">Transaction Receipt</p>
        </div>

        <div class="receipt-amount">
          <p class="receipt-amount-value">€<%= receipt.amount.toFixed(2) %></p>
          <p class="receipt-amount-label">Amount</p>
          <div>
            <span class="receipt-status-badge receipt-status-<%= receipt.status %>"><%= receipt.status %></span>
          </div>
        </div>

        <div class="receipt-rows">
          <div class="receipt-row">
            <span class="receipt-row-label">Reference</span>
            <span class="receipt-row-value"><%= receipt.reference %></span>
          </div>
          <div class="receipt-row">
            <span class="receipt-row-label">Date</span>
            <span class="receipt-row-value"><%= receipt.date %></span>
          </div>
          <div class="receipt-row">
            <span class="receipt-row-label">Type</span>
            <span class="receipt-row-value"><%= receipt.type %></span>
          </div>
          <div class="receipt-row">
            <span class="receipt-row-label">From</span>
            <span class="receipt-row-value"><%= receipt.from %></span>
          </div>
          <div class="receipt-row">
            <span class="receipt-row-label">To</span>
            <span class="receipt-row-value"><%= receipt.to %></span>
          </div>
          <div class="receipt-row">
            <span class="receipt-row-label">Description</span>
            <span class="receipt-row-value"><%= receipt.description %></span>
          </div>
          <div class="receipt-row">
            <span class="receipt-row-label">Category</span>
            <span class="receipt-row-value"><%= receipt.category %></span>
          </div>
        </div>

        <div class="receipt-actions">
          <button type="button" class="btn btn-outline-primary" onclick="downloadPageReceiptPDF()">Save receipt as PDF</button><a href="/dashboard" class="btn btn-primary">Done</a>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
  function downloadPageReceiptPDF() {
    if (!window.jspdf || !window.jspdf.jsPDF) {
      alert('Receipt PDF is still loading. Please try again.');
      return;
    }

    var receipt = {
      reference: <%- JSON.stringify(receipt.reference || '') %>,
      date: <%- JSON.stringify(receipt.date || '') %>,
      type: <%- JSON.stringify(receipt.type || '') %>,
      amount: <%- JSON.stringify(Number(receipt.amount || 0).toFixed(2)) %>,
      status: <%- JSON.stringify(receipt.status || '') %>,
      from: <%- JSON.stringify(receipt.from || '') %>,
      to: <%- JSON.stringify(receipt.to || '') %>,
      description: <%- JSON.stringify(receipt.description || '') %>,
      category: <%- JSON.stringify(receipt.category || '') %>
    };

    var JsPDF = window.jspdf.jsPDF;
    var doc = new JsPDF({ unit: 'mm', format: 'a4' });
    var pageWidth = doc.internal.pageSize.getWidth();
    var y = 24;

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(22);
    doc.text('NovBank', 20, y);

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.text('TRANSACTION RECEIPT', 20, y + 8);

    doc.setDrawColor(220, 226, 235);
    doc.line(20, y + 14, pageWidth - 20, y + 14);

    y += 30;
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(24);
    doc.text('€' + receipt.amount, 20, y);

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.text('Status: ' + receipt.status, pageWidth - 20, y, { align: 'right' });

    y += 18;
    var rows = [
      ['Reference', receipt.reference],
      ['Date', receipt.date],
      ['Type', receipt.type],
      ['From', receipt.from],
      ['To', receipt.to],
      ['Description', receipt.description],
      ['Category', receipt.category]
    ];

    rows.forEach(function(row) {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9);
      doc.text(row[0].toUpperCase(), 20, y);

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      var lines = doc.splitTextToSize(String(row[1] || '—'), pageWidth - 70);
      doc.text(lines, 62, y);
      y += Math.max(9, lines.length * 5 + 4);

      doc.setDrawColor(235, 238, 243);
      doc.line(20, y - 2, pageWidth - 20, y - 2);
    });

    y += 10;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8);
    doc.setTextColor(100, 116, 139);
    doc.text('Generated by NovBank', 20, y);
    doc.text(new Date().toLocaleString(), pageWidth - 20, y, { align: 'right' });

    doc.save('novbank-receipt-' + (receipt.reference || 'transaction') + '.pdf');
  }
</script>

<%- include('../partials/footer') %>