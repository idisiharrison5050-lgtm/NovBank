<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/><link rel="stylesheet" href="/css/transaction-detail.css"/>

<div class="mobile-topbar">
  <span class="mobile-logo">NovBank</span>
  <button class="hamburger-btn" id="hamburgerBtn" aria-label="Open navigation">☰</button>
</div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>
  <main class="dashboard-main nb-detail-page">
    <a class="nb-back" href="/dashboard/transactions">← <span>Back to transactions</span></a>

    <div class="nb-detail-head">
      <div class="nb-detail-icon <%= isCredit ? 'credit' : '' %>"><%= isCredit ? '+' : '−' %></div>
      <div>
        <span>TRANSACTION DETAILS</span>
        <h1><%= transaction.description || transaction.type.replace(/_/g,' ') %></h1>
        <p><%= new Date(transaction.createdAt).toLocaleString('en-GB',{dateStyle:'long',timeStyle:'short'}) %></p>
      </div>
    </div>

    <div class="nb-receipt">
      <div class="nb-receipt-total <%= isCredit ? 'credit' : '' %>">
        <small><%= isCredit ? 'Money received' : 'Money sent' %></small>
        <strong><%= isCredit ? '+' : '-' %>€<%= Number(transaction.amount).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong>
        <span class="txn-status status-<%= transaction.status %>"><%= transaction.status %></span>
      </div>

      <div class="nb-detail-grid">
        <div>
          <span>REFERENCE</span>
          <b class="nb-reference"><%= transaction.reference %></b>
          <button type="button" class="nb-copy" onclick="copyReference('<%= transaction.reference %>')">Copy reference</button>
        </div>
        <div><span>TYPE</span><b><%= transaction.type.replace(/_/g,' ') %></b></div>
        <div><span>CATEGORY</span><b><%= transaction.category || 'Account activity' %></b></div>
        <div><span>DATE</span><b><%= new Date(transaction.createdAt).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) %></b></div>
        <div>
          <span>FROM</span>
          <b><%= transaction.sender ? ((transaction.sender.firstName || '')+' '+(transaction.sender.lastName || '')).trim() : '—' %></b>
          <small><%= transaction.sender ? transaction.sender.accountNumber : '' %></small>
        </div>
        <div>
          <span>TO</span>
          <b><%= transaction.receiver ? ((transaction.receiver.firstName || '')+' '+(transaction.receiver.lastName || '')).trim() : '—' %></b>
          <small><%= transaction.receiver ? transaction.receiver.accountNumber : '' %></small>
        </div>
      </div>
    </div>

    <div class="nb-detail-actions">
      <a href="/dashboard/transactions">Done</a>
    </div>
  </main>
</div>

<script>
  function copyReference(reference) {
    if (!navigator.clipboard) return;
    navigator.clipboard.writeText(reference).then(function () {
      var button = document.querySelector('.nb-copy');
      if (button) {
        button.textContent = 'Copied';
        setTimeout(function () { button.textContent = 'Copy reference'; }, 1400);
      }
    });
  }
</script>

<%- include('../partials/footer') %>