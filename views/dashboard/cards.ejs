<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/cards.css"/>
<link rel="stylesheet" href="/css/cards-premium.css"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn">☰</button></div><div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-cards-page">
  <div class="nb-cards-heading"><div><span>CARDS & PAYMENTS</span><h1>Your cards</h1><p>Manage your NovBank cards and keep control of how you spend.</p></div><a class="nb-card-action" href="#request-card">Request a card</a></div>
  <% if (success_msg && success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %><% if (error_msg && error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
  <% if (cards.length > 0) { %><div class="nb-card-grid"><% cards.forEach(function(card) { %><div class="nb-physical-card card-<%= card.cardType %>"><div class="nb-card-brand">NovBank <span><%= card.cardType.toUpperCase() %></span></div><div class="nb-card-chip"><i></i><i></i><i></i></div><div class="nb-card-number">•••• &nbsp;•••• &nbsp;•••• &nbsp;<%= card.last4 %></div><div class="nb-card-bottom"><div><small>CARDHOLDER</small><b><%= card.cardHolder.toUpperCase() %></b></div><div><small>EXPIRES</small><b><%= card.expiry %></b></div></div><div class="nb-card-status"><%= card.status.charAt(0).toUpperCase()+card.status.slice(1) %></div></div><div class="nb-card-management"><div><span class="nb-account-label">CARD CONTROL</span><strong><%= card.status === "blocked" ? "Card is frozen" : card.status === "active" ? "Card is active" : "Card pending" %></strong><small><%= card.status === "blocked" ? "New card payments should remain disabled until you unfreeze it." : card.status === "active" ? "Freeze the card instantly if you do not recognize activity." : "Your card is waiting for approval." %></small></div><% if (card.status === "active") { %><form action="/cards/<%= card._id %>/freeze" method="POST"><button type="submit" class="nb-card-control danger">Freeze card</button></form><% } else if (card.status === "blocked") { %><form action="/cards/<%= card._id %>/unfreeze" method="POST"><button type="submit" class="nb-card-control">Unfreeze card</button></form><% } %></div></div><% }); %></div><% } else { %><div class="nb-empty-card"><div class="nb-empty-icon">▣</div><h2>No cards yet</h2><p>Request your first NovBank card to get started.</p><a class="nb-card-action" href="#request-card">Request a card</a></div><% } %>
  <div class="nb-card-controls"><div><span>SECURITY</span><h2>Card controls, without the clutter.</h2><p>Keep card management simple with clear status information and protected card details.</p></div><div class="nb-control-list"><div><b>Protected details</b><span>Only the last four digits are displayed.</span></div><div><b>Status visibility</b><span>See whether a card is pending, active or blocked.</span></div><div><b>Dedicated card management</b><span>Keep card activity separate from your main account overview.</span></div></div></div>
  <div class="form-card nb-request-card" id="request-card"><h2>Request a new card</h2><p>Select the card network you'd like to request.</p><form action="/cards/request" method="POST"><div class="nb-card-options"><label><input type="radio" name="cardType" value="visa" required><span><strong>VISA</strong>Personal card</span></label><label><input type="radio" name="cardType" value="mastercard"><span><strong>MASTERCARD</strong>Personal card</span></label></div><button type="submit" class="nb-card-action primary">Request card</button></form></div>
</main></div><%- include('../partials/footer') %>