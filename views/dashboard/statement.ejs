<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/transactions-premium.css"/>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main">
  <section class="nb-transactions-head">
    <span class="nb-transactions-kicker">ACCOUNT SERVICES</span>
    <h1>Account statement</h1>
    <p>A clear record of your NovBank account activity for the selected period.</p>
  </section>
  <form class="nb-statement-filters" method="GET" action="/dashboard/statement">
    <label><span>FROM</span><input type="date" name="from" value="<%= statementFrom.toISOString().slice(0,10) %>"></label>
    <label><span>TO</span><input type="date" name="to" value="<%= statementTo.toISOString().slice(0,10) %>"></label>
    <button type="submit">Apply period</button>
  </form>
  <section class="nb-statement-card">
    <div class="nb-statement-top">
      <div><span>STATEMENT PERIOD</span><strong><%= statementFrom.toLocaleDateString('en-GB') %> — <%= statementTo.toLocaleDateString('en-GB') %></strong></div>
      <div><span>ACCOUNT</span><strong>•••• <%= String(user.accountNumber).slice(-4) %></strong></div>
      <div><span>OPENING BALANCE</span><strong><%= currencySymbol(user.currency || 'EUR') %><%= Number(openingBalance || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></strong></div><div><span>CLOSING BALANCE</span><strong><%= currencySymbol(user.currency || 'EUR') %><%= Number(closingBalance || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></strong></div>
    </div>
    <div class="nb-statement-table-wrap"><table class="nb-statement-table"><thead><tr><th>Date</th><th>Description</th><th>Reference</th><th>Status</th><th>Amount</th></tr></thead><tbody>
    <% if (!transactions.length) { %><tr><td colspan="5">No account activity in this period.</td></tr><% } %>
    <% transactions.forEach(function(txn){ var conversion=txn.type==='currency_conversion'; var outgoing=txn.sender && txn.sender.toString()===user._id.toString() && !conversion; %><tr><td><%= new Date(txn.createdAt).toLocaleDateString('en-GB') %></td><td><%= txn.type === 'wire_transfer' && (!txn.description || txn.description.trim().toLowerCase() === 'wire transfer') ? 'Wire Transfer' : (txn.description || txn.type.replace(/_/g,' ')) %></td><td><%= txn.reference %></td><td><span class="nb-statement-status <%= txn.status %>"><%= txn.status %></span></td><td class="<%= conversion ? 'conversion' : (outgoing ? 'debit' : 'credit') %>"><%= conversion ? '↔ ' : (outgoing ? '−' : '+') %><%= currencySymbol(txn.currency || user.currency || 'EUR') %><%= Number(txn.amount || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></td></tr><% }); %>
    </tbody></table></div>
  </section>
</main></div><%- include('../partials/footer') %>