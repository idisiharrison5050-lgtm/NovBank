<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/transactions-premium.css"/>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main">
  <section class="nb-transactions-head">
    <span class="nb-transactions-kicker">ACCOUNT SERVICES</span>
    <h1>Account statement</h1>
    <p>A clear record of your NovBank account activity for the selected period.</p>
  </section>
  <section class="nb-statement-card">
    <div class="nb-statement-top">
      <div><span>STATEMENT PERIOD</span><strong><%= statementFrom.toLocaleDateString('en-GB') %> — <%= statementTo.toLocaleDateString('en-GB') %></strong></div>
      <div><span>ACCOUNT</span><strong>•••• <%= String(user.accountNumber).slice(-4) %></strong></div>
      <div><span>OPENING BALANCE</span><strong>€<%= Number(openingBalance || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></strong></div><div><span>CLOSING BALANCE</span><strong>€<%= Number(closingBalance || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></strong></div>
    </div>
    <div class="nb-statement-table-wrap"><table class="nb-statement-table"><thead><tr><th>Date</th><th>Description</th><th>Reference</th><th>Status</th><th>Amount</th><th>Balance</th></tr></thead><tbody>
    <% if (!transactions.length) { %><tr><td colspan="6">No account activity in this period.</td></tr><% } %>
    <% transactions.forEach(function(txn){ var outgoing=txn.sender && txn.sender.toString()===user._id.toString(); %><tr><td><%= new Date(txn.createdAt).toLocaleDateString('en-GB') %></td><td><%= txn.description || txn.type.replace(/_/g,' ') %></td><td><%= txn.reference %></td><td><span class="nb-statement-status <%= txn.status %>"><%= txn.status %></span></td><td class="<%= outgoing ? 'debit' : 'credit' %>"><%= outgoing ? '−' : '+' %>€<%= Number(txn.amount || 0).toLocaleString('en-GB',{minimumFractionDigits:2}) %></td><td>—</td></tr><% }); %>
    </tbody></table></div>
  </section>
</main></div><%- include('../partials/footer') %>