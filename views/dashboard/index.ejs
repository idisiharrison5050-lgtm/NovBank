<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<!-- Mobile topbar -->
<div class="mobile-topbar">
  <span class="mobile-logo">NovBank</span>
  <button class="hamburger-btn" id="hamburgerBtn">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</div>

<!-- Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>


<div class="dashboard-layout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-logo">NovBank</div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-link active">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a href="/dashboard/transactions" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Transactions
      </a>
      <a href="/transfer" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        Send Money
      </a>
      <a href="/transfer/wire" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Wire Transfer
      </a>
      <a href="/transfer/deposit" class="sidebar-link">
       <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
     Deposit
      </a>
      <a href="/dashboard/notifications" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        Notifications
        <% if (unreadCount > 0) { %>
          <span class="badge badge-danger ml-1"><%= unreadCount %></span>
        <% } %>
      </a>
      <a href="/dashboard/profile" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Profile
      </a>
    </nav>
    <a href="/logout" class="sidebar-logout">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Logout
    </a>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="dashboard-main">

    <!-- Top Bar -->
    <div class="dash-topbar">
      <div>
        <h1 class="dash-greeting">Good day, <%= user.firstName %>.</h1>
        <p class="dash-date"><%= new Date().toDateString() %></p>
      </div>
      <a href="/dashboard/notifications" class="notif-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <% if (unreadCount > 0) { %><span class="notif-dot"></span><% } %>
      </a>
    </div>

    <% if (success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <!-- Balance Card + Account Info -->
    <div class="row dash-cards">
      <div class="col-md-5">
        <div class="balance-card">
          <p class="balance-label">Available Balance</p>
           <p class="balance-amount">
             € <%= (user.balance !== undefined && user.balance !== null) ? user.balance.toFixed(2) : '0.00' %>
           </p>
          <p class="balance-account"><%= user.accountNumber %></p>
          <p class="balance-name"><%= user.firstName %> <%= user.lastName %></p>
        </div>
      </div>
      <div class="col-md-7">
        <div class="row">
          <div class="col-6">
            <div class="info-card">
              <p class="info-card-label">Account Status</p>
              <p class="info-card-value status-<%= user.accountStatus %>"><%= user.accountStatus.charAt(0).toUpperCase() + user.accountStatus.slice(1) %></p>
            </div>
          </div>
          <div class="col-6">
            <div class="info-card">
              <p class="info-card-label">Currency</p>
              <p class="info-card-value"><%= user.currency %></p>
            </div>
          </div>
          <div class="col-6">
            <div class="info-card">
              <p class="info-card-label">Member Since</p>
              <p class="info-card-value"><%= new Date(user.createdAt).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) %></p>
            </div>
          </div>
          <div class="col-6">
            <div class="info-card">
              <p class="info-card-label">Username</p>
              <p class="info-card-value">@<%= user.username %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
      <a href="/transfer" class="quick-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        Send Money
      </a>
      <a href="/transfer/wire" class="quick-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Wire Transfer
      </a>
      <a href="/transfer/deposit" class="quick-btn">
       <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
       Deposit
      </a>
      <a href="/dashboard/transactions" class="quick-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        History
      </a>
      <a href="/dashboard/profile" class="quick-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Profile
      </a>
    </div>

    <!-- Spending Summary -->
    <% if (spending.length > 0) { %>
    <div class="dash-section">
      <h3 class="section-title">Spending This Month</h3>
      <div class="spending-grid">
        <% spending.forEach(function(item) { %>
          <div class="spending-item">
            <p class="spending-category"><%= item._id %></p>
            <p class="spending-amount">€ <%= item.total.toFixed(2) %></p>
          </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Recent Transactions -->
    <div class="dash-section">
      <div class="section-header-row">
        <h3 class="section-title">Recent Transactions</h3>
        <a href="/dashboard/transactions" class="view-all-link">View All</a>
      </div>
      <% if (transactions.length === 0) { %>
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          <p>No transactions yet.</p>
        </div>
      <% } else { %>
        <div class="txn-list">
          <% transactions.forEach(function(txn) { %>
            <div class="txn-item">
              <div class="txn-icon txn-<%= txn.type %>">
                <% if (txn.type === 'internal_transfer') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                <% } else if (txn.type === 'wire_transfer') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <% } else { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <% } %>
              </div>
              <div class="txn-info">
                <p class="txn-desc"><%= txn.description || txn.type.replace('_', ' ') %></p>
                <p class="txn-meta">
                  <%= txn.category %> &bull;
                  <%= new Date(txn.createdAt).toLocaleDateString('en-GB') %>
                </p>
              </div>
              <div class="txn-right">
                <p class="txn-amount <%= txn.sender && txn.sender._id && txn.sender._id.toString() === user._id.toString() ? 'debit' : 'credit' %>">
                  <%= txn.sender && txn.sender._id && txn.sender._id.toString() === user._id.toString() ? '-' : '+' %>€<%= txn.amount.toFixed(2) %>
                </p>
                <span class="txn-status status-<%= txn.status %>"><%= txn.status %></span>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>