<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/dashboard-premium.css"/>
<link rel="stylesheet" href="/css/dashboard-command.css"/>
<div class="mobile-topbar"><img src="/images/nav.png" alt="NovBank Logo" width="32" height="32" class="d-inline-block me-2" style="border-radius:6px;"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn">☰</button></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-command-dashboard">
  <section class="nb-command-hero"><div><span class="nb-command-kicker">PERSONAL BANKING</span><h1>Good day, <%= user.firstName %>.</h1><p>Your financial snapshot, activity and everyday banking tools in one place.</p></div><div class="nb-command-actions"><a href="/transfer" class="nb-command-primary">Send money</a><a href="/transfer/deposit" class="nb-command-secondary">Add money</a><a href="/transfer/withdraw" class="nb-command-secondary">Withdraw</a><a href="/cards" class="nb-command-secondary">Manage cards</a></div></section>
  <% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %><% if (error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
  <section class="nb-command-grid"><div class="nb-networth-card"><div class="nb-networth-top"><span>AVAILABLE BALANCE</span><a href="/dashboard/profile">Account details →</a></div><strong>€ <%= Number(user.balance || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><div class="nb-networth-meta"><span><i></i><%= user.accountStatus.charAt(0).toUpperCase()+user.accountStatus.slice(1) %> account</span><span>•••• <%= String(user.accountNumber).slice(-4) %></span></div></div><div class="nb-health-card"><span>ACCOUNT HEALTH</span><div class="nb-health-ring"><b><%= user.kycStatus === 'approved' ? '100%' : user.kycStatus === 'pending' ? '75%' : '50%' %></b></div><strong><%= user.kycStatus === 'approved' ? 'Verification complete' : user.kycStatus === 'pending' ? 'Verification in progress' : 'Complete your profile' %></strong><p><%= user.kycStatus === 'approved' ? 'Your account is fully set up.' : 'Finish the remaining steps to unlock your full banking experience.' %></p><a href="/kyc">Review account →</a></div></section>
  <section class="nb-command-actions-grid"><a href="/transfer"><span>↗</span><div><b>Send money</b><small>Move funds to a recipient</small></div><em>→</em></a><a href="/transfer/deposit"><span>↓</span><div><b>Add money</b><small>Fund your account</small></div><em>→</em></a><a href="/cards"><span>▣</span><div><b>Cards</b><small>Manage your payment cards</small></div><em>→</em></a><a href="/airtime"><span>◉</span><div><b>Airtime</b><small>Recharge a mobile number</small></div><em>→</em></a><a href="/transfer/wire"><span>⇄</span><div><b>Wire transfer</b><small>Send through international rails</small></div><em>→</em></a><a href="/loans"><span>€</span><div><b>Loans</b><small>View lending options</small></div><em>→</em></a></section>
  <section class="nb-command-two-col"><div class="nb-command-panel"><div class="nb-panel-heading"><div><span>RECENT ACTIVITY</span><h2>Your latest transactions</h2></div><a href="/dashboard/transactions">View all</a></div><% if (transactions.length === 0) { %><div class="nb-empty-state"><b>No activity yet</b><span>Your account activity will appear here.</span></div><% } else { transactions.forEach(function(txn) { var outgoing = txn.sender && txn.sender._id && txn.sender._id.toString() === user._id.toString(); var credit = txn.type === 'deposit' || txn.type === 'loan_credit' || !outgoing; %><a class="nb-command-txn" href="/dashboard/transactions/<%= txn._id %>"><span class="nb-command-txn-icon <%= credit ? 'credit' : '' %>"><%= credit ? '+' : '−' %></span><div><b><%= txn.description || txn.type.replace(/_/g,' ') %></b><small><%= txn.category || 'Account activity' %> · <%= new Date(txn.createdAt).toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></small></div><strong class="<%= credit ? 'credit' : '' %>"><%= credit ? '+' : '-' %>€<%= Number(txn.amount).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong></a><% }); } %></div></div><div class="nb-command-panel"><div class="nb-panel-heading"><div><span>MONTHLY SPENDING</span><h2>Where your money goes</h2></div></div><% if (spending.length === 0) { %><div class="nb-empty-state"><b>No spending data yet</b><span>Completed spending will be grouped here.</span></div><% } else { var spendTotal = spending.reduce(function(sum,item){return sum + Number(item.total || 0);},0); spending.forEach(function(item){ var pct = spendTotal ? Math.round((Number(item.total)/spendTotal)*100) : 0; %><div class="nb-spend-row"><div><b><%= item._id || 'Other' %></b><span>€ <%= Number(item.total).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></span></div><div class="nb-spend-track"><i style="width:<%= pct %>%"></i></div></div><% }); } %></div></section>
  <section class="nb-dashboard-insight nb-portfolio-overview"><div class="nb-portfolio-heading"><span>PORTFOLIO OVERVIEW</span><h2>Your money, clearly organized.</h2><p>A simple view of what is available, what you have earned and what is currently allocated.</p></div><div class="nb-portfolio-grid"><div class="nb-portfolio-item"><div class="nb-portfolio-item-top"><span>AVAILABLE</span><i>●</i></div><strong>€ <%= Number(user.balance || 0).toLocaleString("en-GB",{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><small>Ready to use</small></div><div class="nb-portfolio-item"><div class="nb-portfolio-item-top"><span>EARNINGS</span><i>↗</i></div><strong>€ <%= Number(user.totalProfit || 0).toLocaleString("en-GB",{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><small>Total account profit</small></div><div class="nb-portfolio-item"><div class="nb-portfolio-item-top"><span>ALLOCATED</span><i>◫</i></div><strong>€ <%= Number(user.activeDeposit || 0).toLocaleString("en-GB",{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><small>Active allocation</small></div></div></section>
  <section class="nb-dashboard-banner"><div><span>YOUR FINANCIAL TOOLKIT</span><h2>Everything important, always within reach.</h2><p>Explore your cards, transfers, funding, airtime, loans and account controls whenever you need them.</p></div><div class="nb-banner-links"><a href="/dashboard/transactions">Transaction history →</a><a href="/dashboard/profile">Account center →</a><a href="/notifications">Secure inbox →</a></div></section>
  <section class="nb-dashboard-insight nb-cashflow-card"><div><span>CASHFLOW PULSE</span><h2>A clearer view of your financial rhythm.</h2><p>Use your recent activity and spending patterns as a quick snapshot of how money is moving through your account.</p></div><div class="nb-cashflow-visual"><div class="nb-cashflow-labels"><span>Recent</span><b>Activity</b></div><div class="nb-cashflow-bars"><i style="height:35%"></i><i style="height:55%"></i><i style="height:42%"></i><i style="height:72%"></i><i style="height:58%"></i><i style="height:88%"></i><i style="height:68%"></i><i style="height:92%"></i></div><small>Illustrative account activity view</small></div></section><section class="nb-command-panel nb-dashboard-tools"><div class="nb-panel-heading"><div><span>KEEP MOVING</span><h2>Useful next steps</h2></div></div><div class="nb-tool-grid"><a href="/transfer"><b>Send money</b><span>Transfer funds securely</span><em>→</em></a><a href="/transfer/deposit"><b>Fund account</b><span>Add money to NovBank</span><em>→</em></a><a href="/dashboard/profile"><b>Account center</b><span>Review your details</span><em>→</em></a><a href="/dashboard/notifications"><b>Secure inbox</b><span>Review account alerts</span><em>→</em></a></div></section><section class="nb-command-footer-card"><div><span>YOUR BANKING DETAILS</span><h2>Everything you need to receive money.</h2><p>Access your account details whenever you need to share them.</p></div><a href="/dashboard/profile">View account details →</a></section>
</main></div><%- include('../partials/footer') %>