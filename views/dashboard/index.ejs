<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/dashboard-premium.css"/>
<div class="mobile-topbar"><img src="/images/nav.png" alt="NovBank Logo" width="32" height="32" class="d-inline-block me-2" style="border-radius:6px;"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn">☰</button></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>
  <main class="dashboard-main nb-premium-dashboard">
    <div class="nb-premium-hero">
      <div><span class="nb-premium-kicker">Financial overview</span><h1>Good day, <%= user.firstName %>.</h1><p><%= new Date().toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %></p></div>
      <div class="nb-premium-actions"><a class="nb-premium-action" href="/dashboard/notifications">Notifications<% if (unreadCount > 0) { %> · <%= unreadCount %><% } %></a><a class="nb-premium-action primary" href="/transfer">Send money</a></div>
    </div>
    <% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %>
    <% if (error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>
    <div class="nb-balance-grid">
      <div class="nb-balance-panel"><span class="label">Available balance</span><div class="amount">€ <%= (user.balance !== undefined && user.balance !== null) ? Number(user.balance).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) : '0.00' %></div><span class="account">Account • <%= user.accountNumber %></span></div>
      <div class="nb-mini-stat-grid"><div class="nb-mini-stat"><span>Account status</span><b><%= user.accountStatus.charAt(0).toUpperCase()+user.accountStatus.slice(1) %></b></div><div class="nb-mini-stat"><span>Currency</span><b><%= user.currency %></b></div><div class="nb-mini-stat"><span>Member since</span><b><%= new Date(user.createdAt).toLocaleDateString('en-GB',{month:'short',year:'numeric'}) %></b></div><div class="nb-mini-stat"><span>Username</span><b>@<%= user.username %></b></div></div>
    </div>
    <div class="quick-actions"><a href="/transfer" class="quick-btn">Send Money</a><a href="/transfer/wire" class="quick-btn">Wire Transfer</a><a href="/transfer/deposit" class="quick-btn">Deposit</a><a href="/cards" class="quick-btn">Cards</a></div>
    <% if (spending.length > 0) { %><div class="nb-dashboard-section"><div class="nb-section-head-row"><h2>Spending this month</h2></div><div class="spending-grid"><% spending.forEach(function(item) { %><div class="nb-mini-stat"><span><%= item._id %></span><b>€ <%= Number(item.total).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></b></div><% }); %></div></div><% } %>
    <div class="nb-dashboard-section"><div class="nb-section-head-row"><h2>Recent activity</h2><a class="nb-section-link" href="/dashboard/transactions">View all</a></div><% if (transactions.length === 0) { %><p style="color:#667085">No transactions yet.</p><% } else { transactions.forEach(function(txn) { var outgoing = txn.sender && txn.sender._id && txn.sender._id.toString() === user._id.toString(); var credit = txn.type === 'deposit' || txn.type === 'loan_credit' || !outgoing; %><div class="nb-transaction-row"><div class="nb-txn-icon"><%= credit ? '+' : '−' %></div><div><strong><%= txn.description || txn.type.replace(/_/g,' ') %></strong><small><%= txn.category %> · <%= new Date(txn.createdAt).toLocaleDateString('en-GB') %></small></div><div class="nb-txn-amount <%= credit ? 'credit' : 'debit' %>"><%= credit ? '+' : '-' %>€<%= Number(txn.amount).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %><span class="nb-txn-status"><%= txn.status %></span></div></div><% }); } %></div>
  </main>
</div>
<%- include('../partials/footer') %>