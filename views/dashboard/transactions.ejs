<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/transactions-premium.css"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn">☰</button></div><div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-transactions-page">
  <div class="nb-transactions-head"><div><span>ACCOUNT ACTIVITY</span><h1>Transactions</h1><p>A clear record of money moving in and out of your account.</p></div><a class="nb-export-btn" href="?filter=<%= filter %>&export=csv">Export</a></div>
  <div class="nb-filter-bar"><a href="?filter=all" class="<%= filter === 'all' ? 'active' : '' %>">All</a><a href="?filter=airtime" class="<%= filter === 'airtime' ? 'active' : '' %>">Airtime</a><a href="?filter=internal_transfer" class="<%= filter === 'internal_transfer' ? 'active' : '' %>">Internal</a><a href="?filter=wire_transfer" class="<%= filter === 'wire_transfer' ? 'active' : '' %>">Wire</a><a href="?filter=deposit" class="<%= filter === 'deposit' ? 'active' : '' %>">Deposits</a></div>
  <% if (transactions.length === 0) { %><div class="nb-no-transactions"><strong>No transactions found.</strong><span>When activity occurs on your account, it will appear here.</span></div><% } else { %>
  <div class="nb-transactions-list"><% transactions.forEach(function(txn) { var outgoing = txn.sender && txn.sender._id && txn.sender._id.toString() === user._id.toString() && txn.type !== 'deposit'; var credit = txn.type === 'deposit' || txn.type === 'loan_credit' || !outgoing; %><a class="nb-transaction-card" href="/dashboard/transactions/<%= txn._id %>"><div class="nb-txn-symbol <%= credit ? 'credit-bg' : '' %>"><%= credit ? '+' : '−' %></div><div class="nb-txn-main"><strong><%= txn.description || txn.type.replace(/_/g,' ') %></strong><span><%= txn.category || 'Account activity' %> · <%= new Date(txn.createdAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></span><small>Ref <%= txn.reference %></small></div><div class="nb-txn-value"><b class="<%= credit ? 'credit' : 'debit' %>"><%= credit ? '+' : '-' %>€<%= Number(txn.amount).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></b><span class="txn-status status-<%= txn.status %>"><%= txn.status %></span></div></a><% }); %></div>
  <div class="nb-pagination"><% if (currentPage > 1) { %><a href="?page=<%= currentPage - 1 %>&filter=<%= filter %>">Previous</a><% } %><span>Page <%= currentPage %> of <%= totalPages %></span><% if (currentPage < totalPages) { %><a href="?page=<%= currentPage + 1 %>&filter=<%= filter %>">Next</a><% } %></div><% } %>
</main></div><%- include('../partials/footer') %>