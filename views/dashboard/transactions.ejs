<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/transactions-premium.css"/><link rel="stylesheet" href="/css/banking-flows.css?v=transactions2"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn" aria-label="Open navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M3 12h18"></path><path d="M3 18h18"></path></svg></button></div><div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %><main class="dashboard-main nb-transactions-page">
  <div class="nb-transactions-head"><div><span>ACCOUNT ACTIVITY</span><h1>Transactions</h1><p>A clear record of money moving in and out of your account.</p></div><a class="nb-export-btn" href="?filter=<%= filter %>&q=<%= encodeURIComponent(search || "") %>&export=csv">Export</a></div>
  <section class="nb-transaction-pulse">
    <div><span>THIS MONTH</span><strong>€<%= Number(monthIncoming || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><small>Money received</small></div>
    <div><span>THIS MONTH</span><strong>€<%= Number(monthOutgoing || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><small>Money sent</small></div>
    <div><span>ATTENTION</span><strong><%= pendingCount || 0 %></strong><small>Pending items</small></div>
  </section>
  <form class="nb-transaction-search" method="GET" action="/dashboard/transactions"><label class="sr-only" for="transactionSearch">Search transactions</label><input id="transactionSearch" type="search" name="q" value="<%= search || '' %>" placeholder="Search reference, description or category"><input type="hidden" name="filter" value="<%= filter %>"><button type="submit">Search</button></form><div class="nb-activity-summary"><div><span>VISIBLE ACTIVITY</span><b><%= transactions.length %></b></div><div><span>VIEW</span><b><%= filter === "all" ? "All activity" : filter.replace(/_/g," ") %></b></div><div><span>PAGE</span><b><%= currentPage %> / <%= totalPages %></b></div></div><div class="nb-filter-label">FILTER ACTIVITY</div><div class="nb-filter-bar"><a href="?filter=all&q=<%= encodeURIComponent(search || "") %>" class="<%= filter === 'all' ? 'active' : '' %>">All</a><a href="?filter=airtime&q=<%= encodeURIComponent(search || "") %>" class="<%= filter === 'airtime' ? 'active' : '' %>">Airtime</a><a href="?filter=internal_transfer&q=<%= encodeURIComponent(search || "") %>" class="<%= filter === 'internal_transfer' ? 'active' : '' %>">Internal</a><a href="?filter=wire_transfer&q=<%= encodeURIComponent(search || "") %>" class="<%= filter === 'wire_transfer' ? 'active' : '' %>">Wire</a><a href="?filter=deposit&q=<%= encodeURIComponent(search || "") %>" class="<%= filter === 'deposit' ? 'active' : '' %>">Deposits</a><a href="?filter=withdrawal&q=<%= encodeURIComponent(search || "") %>" class="<%= filter === 'withdrawal' ? 'active' : '' %>">Withdrawals</a></div>
  <% if (transactions.length === 0) { %><div class="nb-no-transactions"><strong>No transactions found.</strong><span>When activity occurs on your account, it will appear here.</span></div><% } else { %>
  <div class="nb-transactions-list"><% transactions.forEach(function(txn) { var outgoing = txn.sender && txn.sender._id && txn.sender._id.toString() === user._id.toString() && txn.type !== 'deposit'; var credit = txn.type === 'deposit' || txn.type === 'loan_credit' || !outgoing; %><a class="nb-transaction-card" href="/dashboard/transactions/<%= txn._id %>"><div class="nb-txn-symbol <%= credit ? 'credit-bg' : '' %>">
<% if (txn.type === 'airtime') { %><svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2"></rect><path d="M10 6h4"></path><circle cx="12" cy="17" r="1"></circle></svg>
<% } else if (txn.type === 'wire_transfer' || txn.type === 'internal_transfer') { %><svg viewBox="0 0 24 24"><path d="M5 7h14"></path><path d="m15 4 4 3-4 3"></path><path d="M19 17H5"></path><path d="m9 14-4 3 4 3"></path></svg>
<% } else if (txn.type === 'deposit' || txn.type === 'grant_credit' || txn.type === 'refund_credit' || txn.type === 'loan_credit') { %><svg viewBox="0 0 24 24"><path d="M12 5v14"></path><path d="m6 13 6 6 6-6"></path></svg>
<% } else if (txn.type === 'withdrawal') { %><svg viewBox="0 0 24 24"><path d="M12 19V5"></path><path d="m6 11 6-6 6 6"></path></svg>
<% } else { %><span><%= credit ? '+' : '−' %></span><% } %>
</div><div class="nb-txn-main"><strong><%= txn.description || (txn.type === 'withdrawal' && txn.wireDetails && txn.wireDetails.payoutMethod ? 'Withdrawal · ' + txn.wireDetails.payoutMethod.charAt(0).toUpperCase() + txn.wireDetails.payoutMethod.slice(1) : txn.type.replace(/_/g,' ')) %></strong><span><%= txn.category || 'Account activity' %> · <%= new Date(txn.createdAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></span><small>Ref <%= txn.reference %></small></div><div class="nb-txn-value"><b class="<%= credit ? 'credit' : 'debit' %>"><%= credit ? '+' : '-' %>€<%= Number(txn.amount).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></b><span class="txn-status status-<%= txn.status %>"><%= txn.status %></span></div></a><% }); %></div>
  <div class="nb-pagination"><% if (currentPage > 1) { %><a href="?page=<%= currentPage - 1 %>&filter=<%= filter %>&q=<%= encodeURIComponent(search || '') %>">Previous</a><% } %><span>Page <%= currentPage %> of <%= totalPages %></span><% if (currentPage < totalPages) { %><a href="?page=<%= currentPage + 1 %>&filter=<%= filter %>&q=<%= encodeURIComponent(search || '') %>">Next</a><% } %></div><% } %>
</main></div><%- include('../partials/footer') %>