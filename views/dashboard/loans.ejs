<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/loans-premium.css"/>
<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn">☰</button></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="dashboard-layout"><%- include('../partials/sidebar') %>
<main class="dashboard-main nb-loan-page">
  <section class="nb-loan-hero">
    <div><span class="nb-loan-kicker">CREDIT & LENDING</span><h1>Loans</h1><p>Explore your current lending position or submit a new request.</p></div>
    <% if (activeLoan) { %><span class="nb-loan-pill"><%= activeLoan.status === 'approved' ? 'Active facility' : 'Under review' %></span><% } %>
  </section>
  <% if (success_msg && success_msg.length > 0) { %><div class="alert alert-success nb-loan-alert"><%= success_msg %></div><% } %>
  <% if (error_msg && error_msg.length > 0) { %><div class="alert alert-danger nb-loan-alert"><%= error_msg %></div><% } %>
  <% if (activeLoan) { %>
    <section class="nb-loan-grid">
      <div class="nb-loan-card dark">
        <span class="nb-loan-label">CURRENT FACILITY</span>
        <div class="nb-loan-amount">€<%= Number(activeLoan.amount || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div>
        <span class="nb-loan-status <%= activeLoan.status %>"><%= activeLoan.status %></span><% if (activeLoan.status === "approved") { %><div class="nb-loan-progress"><div><span>OUTSTANDING</span><b>€<%= Number(activeLoan.outstanding || activeLoan.amount || 0).toLocaleString("en-GB",{minimumFractionDigits:2,maximumFractionDigits:2}) %></b></div><div class="nb-loan-progress-track"><i style="width:<%= Math.min(100, Math.max(0, ((Number(activeLoan.amountRepaid || 0) / Number(activeLoan.totalDue || activeLoan.amount || 1)) * 100))) %>%"></i></div><small>€<%= Number(activeLoan.amountRepaid || 0).toLocaleString("en-GB",{minimumFractionDigits:2,maximumFractionDigits:2}) %> repaid</small></div><form id="loanRepayForm" action="/loans/repay" method="POST" class="nb-loan-repay"><label>Repayment amount (€)<input type="number" name="amount" min="0.01" max="<%= Number(activeLoan.outstanding || activeLoan.amount) %>" step="0.01" placeholder="0.00" required></label><input type="hidden" name="transactionPin" id="loanRepayPinInput"><input type="hidden" name="idempotencyKey" value="<%= activeLoan._id %>-<%= Date.now() %>"><button type="button" onclick="openPinModal('loanRepayForm')">Make repayment</button></form><% } %>
        <div class="nb-loan-details" style="margin-top:18px">
          <div class="nb-loan-detail"><span>Purpose</span><b><%= activeLoan.purpose %></b></div>
          <div class="nb-loan-detail"><span>Repayment period</span><b><%= activeLoan.repaymentPeriod %> months</b></div>
          <div class="nb-loan-detail"><span>Applied</span><b><%= new Date(activeLoan.createdAt).toLocaleDateString('en-GB') %></b></div>
          <div class="nb-loan-detail"><span>Approved</span><b><%= activeLoan.approvedAt ? new Date(activeLoan.approvedAt).toLocaleDateString('en-GB') : 'Pending' %></b></div>
        </div>
        <% if (activeLoan.status === 'pending') { %><p class="nb-loan-note">Your request is under review. A notification will appear in your Secure Inbox when its status changes.</p><% } %>
      </div>
      <div class="nb-loan-card">
        <span class="nb-loan-label">LOAN OVERVIEW</span>
        <div class="nb-loan-benefits">
          <div class="nb-loan-benefit"><i>✓</i><div><b>Clear application status</b><span>Keep track of the request currently associated with your account.</span></div></div>
          <div class="nb-loan-benefit"><i>◷</i><div><b>Flexible terms</b><span>Choose a repayment period that matches your request.</span></div></div>
          <div class="nb-loan-benefit"><i>⌁</i><div><b>Secure notifications</b><span>Important lending updates are delivered to your account inbox.</span></div></div>
        </div>
      </div>
    </section>
  <% } else { %>
    <section class="nb-loan-card nb-loan-form">
      <span class="nb-loan-label">NEW LOAN REQUEST</span>
      <h2 style="margin:8px 0 4px;font-size:22px;letter-spacing:-.03em">Tell us what you need</h2>
      <p style="color:#667085;font-size:12px;margin-bottom:22px">Provide the requested amount, purpose and preferred repayment period. Requests are subject to review.</p>
      <form action="/loans/request" method="POST">
        <div><label>Loan amount (€)<input type="number" name="amount" placeholder="5,000.00" min="100" step="0.01" required></label></div>
        <div><label>Repayment period<select name="repaymentPeriod" required><option value="" disabled selected>Select period</option><option value="3">3 months</option><option value="6">6 months</option><option value="12">12 months</option><option value="24">24 months</option><option value="36">36 months</option><option value="48">48 months</option><option value="60">60 months</option></select></label></div>
        <div class="full"><label>Purpose<input type="text" name="purpose" placeholder="Business, education, home improvement, working capital..." required></label></div>
        <div class="full"><button type="submit">Submit loan request</button></div>
      </form>
      <p class="nb-loan-disclaimer">Submitting a request does not guarantee approval. Any applicable terms, fees and repayment obligations are presented through the lending process.</p>
    </section>
  <% } %>

  <% if (loanHistory && loanHistory.length > 0) { %>
  <section class="nb-loan-card nb-loan-history">
    <div class="nb-loan-history-head"><div><span class="nb-loan-label">LOAN HISTORY</span><h2>Past and current requests</h2></div><span><%= loanHistory.length %> records</span></div>
    <div class="nb-loan-history-list">
      <% loanHistory.forEach(function(loan){ %>
      <article class="nb-loan-history-row">
        <div><strong>€<%= Number(loan.amount || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><span><%= loan.purpose %> · <%= loan.repaymentPeriod %> months</span></div>
        <div class="nb-loan-history-meta"><span class="nb-loan-status <%= loan.status %>"><%= loan.status %></span><small><%= new Date(loan.createdAt).toLocaleDateString('en-GB') %></small></div>
      </article>
      <% }); %>
    </div>
  </section>
  <% } %>
</main></div>
<%- include('../partials/footer') %>