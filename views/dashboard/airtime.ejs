<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/>

<div class="mobile-topbar">
  <span class="mobile-logo">NovBank</span>
  <button class="hamburger-btn" id="hamburgerBtn">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
</div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <main class="dashboard-main">
    <div class="dash-topbar">
      <h1 class="dash-greeting">Airtime Recharge</h1>
    </div>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <div class="row">
      <div class="col-md-5">
        <div class="form-card">
          <h5 class="form-section-heading">Recharge Airtime</h5>
          <p class="form-card-sub">Available Balance: <strong>€<%= user.balance.toFixed(2) %></strong></p>
          <form action="/airtime/recharge" method="POST">
            <div class="form-group">
              <label>Network Provider</label>
              <select name="network" class="form-control" required>
                <option value="" disabled selected>Select network</option>
                <option value="Telekom">Telekom</option>
                <option value="Vodafone">Vodafone</option>
                <option value="O2">O2</option>
              </select>
            </div>
            <div class="form-group">
              <label>Phone Number</label>
              <input type="tel" name="phone" class="form-control" placeholder="+49 000 00000000" required/>
            </div>
            <div class="form-group">
              <label>Amount (€) — Minimum €50</label>
              <input type="number" name="amount" class="form-control" placeholder="50.00" min="50" step="0.01" required/>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Recharge Now</button>
          </form>
        </div>
      </div>

      <div class="col-md-7">
        <div class="form-card">
          <h5 class="form-section-heading">Recent Recharges</h5>
          <% if (history.length === 0) { %>
            <div class="empty-state">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              <p>No recharges yet.</p>
            </div>
          <% } else { %>
            <% history.forEach(function(a) { %>
              <div class="airtime-history-item">
                <div class="airtime-network-badge"><%= a.network.charAt(0) %></div>
                <div class="airtime-info">
                  <p class="airtime-phone"><%= a.phone %></p>
                  <p class="airtime-meta"><%= a.network %> &bull; <%= new Date(a.createdAt).toLocaleDateString('en-GB') %></p>
                </div>
                <p class="airtime-amount">€<%= a.amount.toFixed(2) %></p>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>