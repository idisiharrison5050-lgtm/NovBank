<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css"/><link rel="stylesheet" href="/css/airtime-premium.css"/>

<div class="mobile-topbar"><span class="mobile-logo">NovBank</span><button class="hamburger-btn" id="hamburgerBtn" aria-label="Open navigation">☰</button></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>
  <main class="dashboard-main nb-airtime-page">
    <div class="nb-airtime-head">
      <div><span class="nb-airtime-kicker">EVERYDAY PAYMENTS</span><h1>Airtime recharge</h1><p>Top up a supported mobile number directly from your NovBank balance.</p></div>
      <div class="nb-airtime-balance"><span>AVAILABLE BALANCE</span><strong>€<%= Number(user.balance || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong></div>
    </div>

    <% if (success_msg && success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg %></div><% } %>
    <% if (error_msg && error_msg.length > 0) { %><div class="alert alert-danger"><%= error_msg %></div><% } %>

    <div class="nb-airtime-grid">
      <section class="nb-airtime-card">
        <div class="nb-airtime-card-head"><div><span>NEW RECHARGE</span><h2>Choose amount</h2></div><div class="nb-airtime-mark">₦</div></div>
        <form action="/airtime/recharge" method="POST">
          <div class="form-group"><label>Network provider</label><select name="network" class="form-control" required><option value="" disabled selected>Select network</option><option value="Telekom">Telekom</option><option value="Vodafone">Vodafone</option><option value="O2">O2</option></select></div>
          <div class="form-group"><label>Phone number</label><input type="tel" name="phone" class="form-control" placeholder="+49 000 00000000" autocomplete="tel" required/></div>
          <div class="form-group"><label>Amount <span>Minimum €50</span></label><input type="number" name="amount" class="form-control" placeholder="50.00" min="50" step="0.01" required/></div>
          <button type="submit" class="btn btn-primary btn-block nb-airtime-submit">Recharge now</button>
        </form>
        <div class="nb-airtime-note">Your recharge is recorded in your account activity after a successful request.</div>
      </section>

      <section class="nb-airtime-card">
        <div class="nb-airtime-card-head"><div><span>ACTIVITY</span><h2>Recent recharges</h2></div><span class="nb-airtime-count"><%= history.length %></span></div>
        <% if (history.length === 0) { %>
          <div class="nb-airtime-empty"><div class="nb-airtime-empty-icon">◷</div><strong>No recharges yet</strong><p>Your completed airtime recharges will appear here.</p></div>
        <% } else { %>
          <div class="nb-airtime-list">
            <% history.forEach(function(a) { %>
              <div class="nb-airtime-item">
                <div class="nb-airtime-network"><%= a.network.charAt(0) %></div>
                <div class="nb-airtime-info"><strong><%= a.phone %></strong><span><%= a.network %> · <%= new Date(a.createdAt).toLocaleDateString('en-GB') %></span></div>
                <strong class="nb-airtime-amount">€<%= Number(a.amount).toFixed(2) %></strong>
              </div>
            <% }); %>
          </div>
        <% } %>
      </section>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>