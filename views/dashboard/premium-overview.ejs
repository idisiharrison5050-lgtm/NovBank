<link rel="stylesheet" href="/css/dashboard-premium.css">
<div class="nb-premium-dashboard">
  <div class="nb-premium-hero"><div><span class="nb-premium-kicker">Financial overview</span><h1>Good day, <%= user.firstName %>.</h1><p><%= new Date().toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %></p></div><div class="nb-premium-actions"><a class="nb-premium-action" href="/dashboard/notifications">Notifications</a><a class="nb-premium-action primary" href="/transfer">Send money</a></div></div>
  <div class="nb-balance-grid">
    <div class="nb-balance-panel"><span class="label">Available balance</span><div class="amount">€ <%= Number(user.balance || 0).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div><span class="account">Account • <%= user.accountNumber %></span></div>
    <div class="nb-mini-stat-grid"><div class="nb-mini-stat"><span>Account status</span><b><%= user.accountStatus ? user.accountStatus.charAt(0).toUpperCase()+user.accountStatus.slice(1) : 'Active' %></b></div><div class="nb-mini-stat"><span>Currency</span><b><%= user.currency || 'EUR' %></b></div><div class="nb-mini-stat"><span>Member since</span><b><%= new Date(user.createdAt).toLocaleDateString('en-GB',{month:'short',year:'numeric'}) %></b></div><div class="nb-mini-stat"><span>Username</span><b>@<%= user.username %></b></div></div>
  </div>
  <div class="nb-dashboard-section"><div class="nb-section-head-row"><h2>Recent activity</h2><a class="nb-section-link" href="/dashboard/transactions">View all</a></div><% if (!transactions || transactions.length === 0) { %><p style="color:#667085">Your recent activity will appear here.</p><% } else { transactions.forEach(function(txn){ var outgoing = txn.sender && txn.sender._id && txn.sender._id.toString() === user._id.toString(); %><div class="nb-transaction-row"><div class="nb-txn-icon">↗</div><div><strong><%= txn.description || txn.type.replace(/_/g,' ') %></strong><small><%= txn.category || 'Account activity' %> · <%= new Date(txn.createdAt).toLocaleDateString('en-GB') %></small></div><div class="nb-txn-amount <%= outgoing ? 'debit' : 'credit' %>"><%= outgoing ? '-' : '+' %>€<%= Number(txn.amount).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %><span class="nb-txn-status"><%= txn.status %></span></div></div><% }); } %></div>
</div>
