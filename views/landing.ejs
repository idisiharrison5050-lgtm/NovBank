<script>
  function toggleFaq(btn) {
    var item   = btn.parentElement;
    var answer = item.querySelector('.faq-answer');
    var isOpen = item.classList.contains('open');

    document.querySelectorAll('.faq-item.open').forEach(function (el) {
      el.classList.remove('open');
      el.querySelector('.faq-answer').style.maxHeight = null;
    });

    if (!isOpen) {
      item.classList.add('open');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var bannerImg = document.getElementById("landingBannerImg");
    
    // 1. Instantly triggers the fade-in for the image on load
    if (bannerImg) {
      setTimeout(function() {
        bannerImg.classList.add("img-loaded");
      }, 50);
    }
    
    // 2. Dynamic Scroll Engine
    window.addEventListener("scroll", function() {
      if (bannerImg) {
        var scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
        if (scrollPosition > 80) {
          var activeScroll = scrollPosition - 80;
          var yOffset = activeScroll * 0.35;
          
          bannerImg.style.transform = "translate3d(0px, " + yOffset + "px, 0px)";
        } else {
          bannerImg.style.transform = "translate3d(0px, 0px, 0px)";
        }
      }
    });
  });
</script>

