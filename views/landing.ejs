<%- include('partials/header') %>
<link rel="stylesheet" href="/css/landing.css"/>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light landing-nav">
  <div class="container">
    <a class="navbar-brand nav-logo" href="/">NovBank</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ml-auto align-items-center">
        <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
        <li class="nav-item"><a class="nav-link" href="#how-it-works">How It Works</a></li>
        <li class="nav-item"><a class="nav-link" href="#security">Security</a></li>
        <% if (user) { %>
          <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="btn btn-outline-secondary btn-nav-cta" href="/logout">Logout</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
          <li class="nav-item"><a class="btn btn-primary btn-nav-cta" href="/register">Open Account</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6">
        <p class="hero-badge">Trusted by thousands across Europe</p>
        <h1 class="hero-title">Banking that works<br/><span>for your life.</span></h1>
        <p class="hero-subtitle">Send money, manage your finances, and track spending — all in one secure place.</p>
        <% if (user) { %>
          <a href="/dashboard" class="btn btn-primary btn-lg hero-cta">Go to Dashboard</a>
        <% } else { %>
          <a href="/register" class="btn btn-primary btn-lg hero-cta">Get Started Free</a>
          <a href="#how-it-works" class="btn btn-outline-secondary btn-lg ml-2">Learn More</a>
        <% } %>
      </div>
      <div class="col-md-6 hero-right">
        <div class="hero-card-mockup">
          <div class="mockup-card">
            <p class="mockup-label">Total Balance</p>
            <p class="mockup-amount">€ 12,450.00</p>
            <p class="mockup-account">EU •••• •••• 4821</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
<section class="stats-section">
  <div class="container">
    <div class="row text-center">
      <div class="col-md-3 col-6 stat-item">
        <h2 class="stat-number">250K+</h2>
        <p class="stat-label">Active Users</p>
      </div>
      <div class="col-md-3 col-6 stat-item">
        <h2 class="stat-number">€2B+</h2>
        <p class="stat-label">Transferred</p>
      </div>
      <div class="col-md-3 col-6 stat-item">
        <h2 class="stat-number">99.9%</h2>
        <p class="stat-label">Uptime</p>
      </div>
      <div class="col-md-3 col-6 stat-item">
        <h2 class="stat-number">40+</h2>
        <p class="stat-label">Countries Supported</p>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="features-section" id="features">
  <div class="container">
    <div class="section-header text-center">
      <h2>Everything you need in a bank</h2>
      <p>Simple tools for modern financial life.</p>
    </div>
    <div class="row">
      <div class="col-md-4 feature-card">
        <div class="feature-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h4>Instant Transfers</h4>
        <p>Send money to anyone on NovBank instantly. No delays, no fees between members.</p>
      </div>
      <div class="col-md-4 feature-card">
        <div class="feature-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <h4>Wire Transfers</h4>
        <p>Send funds internationally via IBAN and SWIFT/BIC to any bank in the world.</p>
      </div>
      <div class="col-md-4 feature-card">
        <div class="feature-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h4>Spending Insights</h4>
        <p>Track where your money goes with categorized spending summaries every month.</p>
      </div>
      <div class="col-md-4 feature-card">
        <div class="feature-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h4>Bank-Level Security</h4>
        <p>Your account is protected with encrypted sessions and activity monitoring.</p>
      </div>
      
     
</section>

<!-- HOW IT WORKS -->
<section class="how-section" id="how-it-works">
  <div class="container">
    <div class="section-header text-center">
      <h2>Up and running in minutes</h2>
      <p>Three simple steps to get started.</p>
    </div>
    <div class="row text-center">
      <div class="col-md-4 step-item">
        <div class="step-number">1</div>
        <h5>Create Your Account</h5>
        <p>Fill in your personal details in our quick 3-step registration form.</p>
      </div>
      <div class="col-md-4 step-item">
        <div class="step-number">2</div>
        <h5>Get Your Account Number</h5>
        <p>We auto-generate a unique European account number for you instantly.</p>
      </div>
      <div class="col-md-4 step-item">
        <div class="step-number">3</div>
        <h5>Start Banking</h5>
        <p>Send money, check your balance, and manage everything from your dashboard.</p>
      </div>
    </div>
  </div>
</section>

<!-- SECURITY -->
<section class="security-section" id="security">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6">
        <h2>Your security is our priority</h2>
        <p>We use industry-standard encryption and session management to keep your account safe at all times.</p>
        <ul class="security-list">
          <li>256-bit password hashing with bcrypt</li>
          <li>Encrypted session storage</li>
          <li>Activity notifications for every transaction</li>
          <li>Auto session expiry after inactivity</li>
        </ul>
      </div>
      <div class="col-md-6 security-right text-center">
        <div class="security-badge-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#1a56db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <p>Protected</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA BANNER -->
<section class="cta-banner-section">
  <div class="container text-center">
    <h2>Ready to take control of your money?</h2>
    <p>Join NovBank today. No hidden fees. No paperwork.</p>
    <a href="/register" class="btn btn-primary btn-lg">Open a Free Account</a>
  </div>
</section>

<%- include('partials/footer') %>