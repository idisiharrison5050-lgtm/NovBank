<%- include('landing/premium') %>

<style>
/* V1 desktop capability-card polish: keep the mobile design untouched. */
@media (min-width: 769px) {
  .nb-capabilities {
    background: #f8fafc;
    padding-top: 96px;
    padding-bottom: 104px;
  }

  .nb-capabilities .nb-section-head {
    max-width: 760px;
    margin-bottom: 34px;
  }

  .nb-capability-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .nb-capability-grid article {
    min-width: 0;
    padding: 0;
    min-height: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .nb-capability-card {
    position: relative;
    min-height: 238px;
    height: 100%;
    padding: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid #e4e8ef;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 10px 30px rgba(16, 24, 40, .055);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }

  .nb-capability-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 3px;
    border-radius: 0 0 6px 6px;
    background: #155eef;
  }

  .nb-capability-grid article:nth-child(2) .nb-capability-card::before {
    background: #0b1220;
  }

  .nb-capability-grid article:nth-child(3) .nb-capability-card::before {
    background: #12b76a;
  }

  .nb-capability-grid article:nth-child(4) .nb-capability-card::before {
    background: #f79009;
  }

  .nb-capability-grid article:nth-child(5) .nb-capability-card::before {
    background: #7f56d9;
  }

  .nb-capability-grid article:nth-child(6) .nb-capability-card::before {
    background: #039855;
  }

  .nb-capability-card:hover {
    transform: translateY(-5px);
    border-color: #d5dce7;
    box-shadow: 0 20px 45px rgba(16, 24, 40, .10);
  }

  .nb-capability-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
  }

  .nb-capability-icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    display: grid;
    place-items: center;
    border: 1px solid #dbe5f7;
    border-radius: 14px;
    background: #f5f8ff;
    color: #155eef;
  }

  .nb-capability-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nb-capability-arrow {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid #e4e8ef;
    border-radius: 50%;
    background: #fff;
    color: #667085;
    font-size: 16px;
    line-height: 1;
  }

  .nb-capability-number {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 4px 8px;
    border: 1px solid #dbe5f7;
    border-radius: 8px;
    background: #f5f8ff;
    color: #155eef;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .04em;
  }

  .nb-capability-card h3 {
    margin: 15px 0 9px;
    color: #0b1220;
    font-size: 21px;
    line-height: 1.12;
    letter-spacing: -.025em;
  }

  .nb-capability-card p {
    max-width: 330px;
    margin: 0;
    color: #667085;
    font-size: 14px;
    line-height: 1.65;
  }
}
</style>
