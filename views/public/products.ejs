<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Products | NovBank</title>
  <link rel="stylesheet" href="/css/public-pages.css">
</head>
<body>
  <div class="nb-public-shell">
    <%- include('../partials/public-nav') %>
    <main>
      <section class="nb-public-hero">
        <span class="nb-kicker">NOVBANK PRODUCTS</span>
        <h1>Financial tools built around the way you manage money.</h1>
        <p>Explore accounts, cards, payments and money-movement capabilities in one connected banking platform.</p>
        <div class="nb-public-actions"><a class="nb-btn nb-btn-primary" href="/register">Open an account</a><a class="nb-btn" href="/">Back to home</a></div>
      </section>
      <section class="nb-public-section">
        <div class="nb-public-grid">
